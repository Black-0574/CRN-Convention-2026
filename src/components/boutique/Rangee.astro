---
/*
  Rangée de produits : carrousel horizontal sur mobile (glissement natif inertiel avec
  aimantation, pastille active qui s'allonge de 8 à 24 px, en or), grille de 3 ou 4 colonnes sur
  ordinateur. Jamais de défilement automatique (règle permanente n° 10).
*/
import type { VueProduit } from '../../lib/boutique-api';
import CarteProduit from './CarteProduit.astro';

interface Props {
  titre: string;
  surtitre?: string;
  produits: VueProduit[];
  id: string;
}
const { titre, surtitre, produits, id } = Astro.props;
---

{produits.length > 0 && (
  <section class="rangee" aria-labelledby={`${id}-titre`}>
    {surtitre && <p class="rangee__surtitre">{surtitre}</p>}
    <h2 id={`${id}-titre`} class="rangee__titre">{titre}</h2>
    <ul class="rangee__liste" data-rangee={id}>
      {produits.map((p) => (
        <li class="rangee__element"><CarteProduit produit={p} /></li>
      ))}
    </ul>
    {produits.length > 1 && (
      <div class="rangee__pastilles" data-pastilles={id} aria-hidden="true">
        {produits.map((_, i) => <span class:list={['rangee__pastille', { 'rangee__pastille--active': i === 0 }]} />)}
      </div>
    )}
  </section>
)}

<script>
  document.querySelectorAll<HTMLUListElement>('[data-rangee]').forEach((liste) => {
    const pastilles = document.querySelectorAll<HTMLElement>(`[data-pastilles="${liste.dataset.rangee}"] .rangee__pastille`);
    if (!pastilles.length) return;
    const majPastilles = () => {
      const largeur = (liste.firstElementChild as HTMLElement | null)?.offsetWidth ?? 1;
      const index = Math.round(liste.scrollLeft / (largeur + 16));
      pastilles.forEach((p, i) => p.classList.toggle('rangee__pastille--active', i === index));
    };
    liste.addEventListener('scroll', majPastilles, { passive: true });
  });
</script>

<style>
  .rangee {
    margin-top: var(--space-6);
  }

  .rangee__surtitre {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--crn-or-profond);
    font-size: 16px;
  }

  .rangee__titre {
    margin: 4px 0 var(--space-3);
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h2-mobile);
  }

  .rangee__liste {
    list-style: none;
    margin: 0;
    padding: 4px 0 8px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .rangee__liste::-webkit-scrollbar {
    display: none;
  }

  .rangee__element {
    scroll-snap-align: start;
  }

  .rangee__pastilles {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
  }

  .rangee__pastille {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--crn-gris-clair);
    transition: width 300ms cubic-bezier(0.16, 1, 0.3, 1), background-color 300ms ease;
  }

  .rangee__pastille--active {
    width: 24px;
    background: var(--crn-or);
  }

  @media (prefers-reduced-motion: reduce) {
    .rangee__liste {
      scroll-behavior: auto;
    }
    .rangee__pastille {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .rangee__titre {
      font-size: var(--text-h2);
    }

    .rangee__liste {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }

    .rangee__pastilles {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .rangee__liste {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
