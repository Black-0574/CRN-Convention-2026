---
/*
  Carte d'un article officiel : carte blanche posée sur un cadre or invisible au repos, qui bascule
  en pivotant derrière elle au survol (ou au focus clavier). Seconde photo au survol si elle
  existe, favori, aperçu rapide et accès à la fiche (choix de taille et quantité). Photo absente :
  cadre neutre marqué (jamais d'image inventée). Aucun avis ni note affiché : il n'en existe pas.
  Animations neutralisées par prefers-reduced-motion.
*/
import { lienProduit, type EmplacementBoutique } from '../../lib/boutique';
import type { VueProduit } from '../../lib/boutique-api';
import { formaterEUR, formaterXAF } from '../../lib/boutique-format';
import { rayonDe, texteRecherche } from '../../lib/boutique-rayons';

interface Props {
  produit: VueProduit;
  /** Depuis une page du site : lien suivi vers la fiche (LOT A, A5). */
  suivi?: EmplacementBoutique;
  /** Sans favori ni aperçu rapide (pages du site hors boutique : pas de script de la boutique). */
  simple?: boolean;
}
const { produit: p, suivi, simple = false } = Astro.props;
const [photo1, photo2] = p.photos;
const lien = suivi ? lienProduit(p.slug, suivi) : `/boutique/produits/${p.slug}`;
---

<article
  class="article"
  data-produit={p.slug}
  data-rayon={rayonDe(p)}
  data-recherche={texteRecherche(p)}
  data-prix={p.prixXAF ?? ''}
  data-date=""
  data-ordre={p.ordre}
>
  <div class="article__carte">
    <div class="article__media">
      {photo1 ? (
        <>
          <img class="article__photo" src={photo1.carte} alt={photo1.alt} width="480" height="480" loading="lazy" />
          {photo2 && <img class="article__photo article__photo--seconde" src={photo2.carte} alt="" width="480" height="480" loading="lazy" />}
        </>
      ) : (
        <div class="article__cadre" aria-hidden="true">
          <span class="article__sigle">CRN</span>
          <span class="article__note">Photo à venir</span>
        </div>
      )}
      {!simple && (
        <button type="button" class="article__favori" data-favori={p.slug} aria-pressed="false" aria-label={`Ajouter ${p.nom} aux favoris`}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9Z" /></svg>
        </button>
      )}
    </div>

    <div class="article__corps">
      {p.badge && <span class="article__badge">{p.badge}</span>}
      <h3 class="article__nom"><a href={lien}>{p.nom}</a></h3>
      <p class="article__prix">
        {p.prixXAF !== null ? (
          <>
            <strong>{formaterXAF(p.prixXAF)}</strong> <span class="article__euros">{formaterEUR(p.prixXAF)}</span>
          </>
        ) : (
          <strong>À annoncer</strong>
        )}
      </p>
      {p.indisponible && <p class="article__etat">{p.indisponible}</p>}
    </div>

    <div class="article__actions">
      {!simple && (
        <button type="button" class="article__action article__action--survol" data-apercu-rapide={p.slug} aria-label={`Aperçu rapide : ${p.nom}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        </button>
      )}
      <a class="article__action" href={lien} aria-label={`Choisir la taille et la quantité : ${p.nom}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9Z" /><path d="M9 10V6a3 3 0 0 1 6 0v4" /></svg>
      </a>
    </div>
  </div>

  {!simple && <template data-gabarit-apercu={p.slug}>
    <h2>{p.nom}</h2>
    {p.resume && <p>{p.resume}</p>}
    <p><strong>{p.prixXAF !== null ? formaterXAF(p.prixXAF) : 'À annoncer'}</strong>{p.prixXAF !== null && <span> · {formaterEUR(p.prixXAF)}</span>}</p>
    {p.variantes.length > 1 && <p>Tailles : {p.variantes.map((v) => v.libelle).join(', ')}</p>}
    <a class="button button--primary" href={lien}>Voir le produit</a>
  </template>}
</article>

<style>
  .article {
    position: relative;
    isolation: isolate;
    height: 100%;
    padding: 6px;
  }

  /* Cadre or caché exactement derrière la carte ; il pivote au survol. */
  .article::before {
    content: '';
    position: absolute;
    inset: 6px;
    z-index: -1;
    border-radius: var(--radius-card);
    background: var(--crn-or);
    transform-origin: 30% 100%;
    transition: transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .article:hover::before,
  .article:focus-within::before {
    transform: rotate(-4deg) translate(-4px, -2px);
  }

  .article__carte {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 12px 12px 16px;
    transition: box-shadow var(--transition-standard), transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .article:hover .article__carte,
  .article:focus-within .article__carte {
    box-shadow: var(--shadow-lift);
    transform: rotate(1deg);
  }

  .article__media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-card-sm);
    overflow: hidden;
    background: var(--crn-creme);
  }

  .article__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 400ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .article__photo--seconde {
    opacity: 0;
  }

  .article:hover .article__photo--seconde {
    opacity: 1;
  }

  .article__cadre {
    position: absolute;
    inset: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1.5px dashed var(--crn-or);
    border-radius: var(--radius-card-sm);
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
  }

  .article__sigle {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: 39px;
    letter-spacing: 0.08em;
    color: var(--crn-or);
  }

  .article__note {
    color: var(--crn-blanc);
    font-size: 16px;
  }

  .article__favori {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--crn-bleu-nuit);
    cursor: pointer;
  }

  .article__favori[aria-pressed='true'] {
    color: var(--crn-or);
  }

  .article__favori[aria-pressed='true'] svg {
    fill: currentColor;
  }

  .article__corps {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 64px 0 4px;
    flex: 1;
  }

  .article__badge {
    align-self: flex-start;
    padding: 2px 12px;
    border: 1px solid var(--crn-or);
    border-radius: var(--radius-pill);
    color: var(--crn-bleu-nuit);
    font-size: 16px;
    font-weight: 700;
  }

  .article__nom {
    margin: 0;
    font-family: var(--font-labeur);
    font-size: 20px;
    line-height: 1.25;
  }

  .article__nom a {
    color: var(--crn-noir);
    text-decoration: none;
  }

  .article__nom a:hover {
    text-decoration: underline;
  }

  .article__prix {
    margin: auto 0 0;
    color: var(--crn-bleu-nuit);
    font-size: 18px;
  }

  .article__euros {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .article__etat {
    margin: 0;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  /* Boutons ronds en bas à droite ; l'aperçu rapide apparaît au survol. */
  .article__actions {
    position: absolute;
    right: 14px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .article__action {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--crn-creme);
    color: var(--crn-bleu-nuit);
    cursor: pointer;
    transition: background-color var(--transition-standard), color var(--transition-standard), opacity 300ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .article__action:hover {
    background: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
  }

  .article__action--survol {
    opacity: 0;
    transform: translateY(10px);
  }

  .article:hover .article__action--survol,
  .article:focus-within .article__action--survol {
    opacity: 1;
    transform: none;
  }

  .article__favori:focus-visible,
  .article__action:focus-visible,
  .article__nom a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  /* Écrans tactiles : pas de survol, l'aperçu rapide reste visible. */
  @media (hover: none) {
    .article__action--survol {
      opacity: 1;
      transform: none;
    }
  }

  /* Animations réduites : le cadre or apparaît au survol, sans mouvement. */
  @media (prefers-reduced-motion: reduce) {
    .article::before,
    .article__carte,
    .article__photo,
    .article__action {
      transition: none;
    }

    .article:hover .article__carte,
    .article:focus-within .article__carte {
      transform: none;
    }
  }
</style>
