---
import { Image } from 'astro:assets';
import Icon from '../shared/Icon.astro';
import emblem from '../../assets/images/emblemes-dores-convention-2026.png';
import { lienBoutique } from '../../lib/boutique';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

interface NavLink {
  href: string;
  label: string;
}

interface NavItem extends Partial<NavLink> {
  label: string;
  href?: string;
  children?: NavLink[];
}

const navItems: NavItem[] = [
  { href: '/programme', label: 'Programme' },
  { href: '/academie', label: 'Académie' },
  { href: '/action-sociale', label: 'Action sociale' },
  { href: '/infos-pratiques', label: 'Infos pratiques' },
  {
    label: 'Multimédia',
    children: [
      { href: '/multimedia/galerie-videos', label: 'Galerie vidéos' },
      { href: '/multimedia/galerie-photos', label: 'Galerie photos' },
      { href: '/multimedia/galerie-audios', label: 'Galerie audios' },
      { href: '/actualites', label: 'Actualités' },
    ],
  },
  { href: '/diaspora', label: 'Diaspora' },
  { href: '/faq', label: 'FAQ' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class={`site-header ${transparent ? 'site-header--overlay' : ''}`} id="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Convention CRN 2026 — accueil">
      <Image src={emblem} alt="" width={240} height={96} loading="eager" />
      <span class="visually-hidden">Convention CRN 2026</span>
    </a>

    <nav class="site-header__nav" id="site-nav" aria-label="Navigation principale">
      <ul class="site-header__pill">
        {navItems.map((item) => (
          item.children ? (
            <li class="site-header__nav-item">
              <button type="button" class="site-header__nav-trigger" aria-expanded="false" aria-haspopup="true">
                <span>{item.label}</span>
                <Icon name="chevron-down" size={14} />
              </button>
              <ul class="site-header__submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={currentPath === child.href ? 'page' : undefined}>
                      <span>{child.label}</span>
                      <Icon name="arrow-right" size={16} />
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                <span>{item.label}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          )
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <!-- LOT A, A1 : la pilule mène à la Boutique de la Convention (lien suivi, A5). Libellé
           complet dès 768 px, « La boutique » en dessous ; le nom accessible reste complet partout. -->
      <a class="site-header__badge" href={lienBoutique('en-tete')} aria-label="Accédez à la Boutique de la Convention">
        <span class="site-header__badge-icon"><Icon name="bag" size={24} /></span>
        <span class="site-header__badge-text" aria-hidden="true">
          <span class="site-header__badge-label">Accédez à la</span>
          <span class="site-header__badge-value">
            <span class="site-header__badge-long">Boutique de la Convention</span>
            <span class="site-header__badge-short">La boutique</span>
          </span>
        </span>
      </a>

      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        id="nav-toggle"
      >
        <span class="visually-hidden">Ouvrir le menu</span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Hauteur réelle de l'en-tête, pour que le héros de l'accueil remonte exactement dessous (elle
     varie selon la largeur d'écran et le chargement des polices). En ligne et synchrone : la valeur
     est posée avant l'affichage du héros, donc sans décalage visible. -->
<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    if (!header) return;
    var set = function () {
      document.documentElement.style.setProperty('--site-header-h', header.offsetHeight + 'px');
    };
    set();
    if ('ResizeObserver' in window) new ResizeObserver(set).observe(header);
  })();
</script>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  const siteHeader = document.getElementById('site-header');
  const toggleLabel = toggle?.querySelector('.visually-hidden');
  const setNavOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggleLabel) toggleLabel.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    nav?.classList.toggle('is-open', open);
    siteHeader?.classList.toggle('has-open-nav', open);
    // Hauteur maximale d'après la position réelle du menu (barre du haut visible ou non) : le
    // menu tient toujours dans l'écran et défile en interne au besoin.
    if (open && nav) nav.style.maxHeight = `${Math.max(200, window.innerHeight - nav.getBoundingClientRect().top - 12)}px`;
  };
  toggle?.addEventListener('click', () => {
    setNavOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  // Menu mobile : se referme au toucher hors du menu, avec Échap (focus rendu au bouton) et en
  // repassant en largeur bureau (rotation de l'écran).
  document.addEventListener('click', (event) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true' || !(event.target instanceof Node)) return;
    if (!nav?.contains(event.target) && !toggle.contains(event.target)) setNavOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setNavOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setNavOpen(false);
  });

  // Sous-menu « Multimédia » : ouverture au clic/tap (accessible au clavier et au tactile,
  // contrairement à un survol CSS seul), un seul sous-menu ouvert à la fois, fermeture à
  // l'extérieur ou avec Échap.
  const submenuTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.site-header__nav-trigger'));
  const closeAllSubmenus = (except?: HTMLButtonElement) => {
    submenuTriggers.forEach((btn) => {
      if (btn !== except) {
        btn.setAttribute('aria-expanded', 'false');
        btn.closest('.site-header__nav-item')?.classList.remove('is-open');
      }
    });
  };
  submenuTriggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      closeAllSubmenus();
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.site-header__nav-item')?.classList.toggle('is-open', !expanded);
    });
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    const insideSubmenu = submenuTriggers.some((btn) => btn.closest('.site-header__nav-item')?.contains(event.target as Node));
    if (!insideSubmenu) closeAllSubmenus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllSubmenus();
  });

  // En-tête transparent « posé » sur le héros : redevient opaque dès qu'on quitte le haut de page.
  const header = document.getElementById('site-header');
  if (header?.classList.contains('site-header--overlay')) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 48);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(16, 16, 16, 0.06), 0 12px 32px -24px rgba(16, 16, 16, 0.25);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color var(--transition-standard), box-shadow var(--transition-standard);
  }

  /* En-tête transparent « posé » sur le héros (accueil uniquement). Reste "sticky" comme l'en-tête
     normal (la place est réservée dans le flux ; .hero remonte dessous via margin-top négatif) ;
     seul le fond devient transparent tant qu'on n'a pas défilé (.is-scrolled, script ci-dessous). */
  .site-header--overlay {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header--overlay.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(16, 16, 16, 0.06), 0 12px 32px -24px rgba(16, 16, 16, 0.25);
  }

  .site-header--overlay .site-header__toggle {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(16, 16, 16, 0.2);
  }

  .site-header--overlay .site-header__toggle-bar,
  .site-header--overlay .site-header__toggle-bar::before,
  .site-header--overlay .site-header__toggle-bar::after {
    background: var(--crn-blanc);
  }

  .site-header--overlay.is-scrolled .site-header__toggle {
    border-color: var(--color-border);
    background: none;
  }

  .site-header--overlay.is-scrolled .site-header__toggle-bar,
  .site-header--overlay.is-scrolled .site-header__toggle-bar::before,
  .site-header--overlay.is-scrolled .site-header__toggle-bar::after {
    background: var(--color-text);
  }

  /* Mobile d'abord : logo, pilule « La boutique » et bouton de menu doivent tenir sur une seule
     ligne dès 320 px de large, sans jamais élargir la page (un en-tête trop large rendait tout le
     site défilable de côté sur téléphone). Les tailles « confort » reviennent à partir de 640 px. */
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    padding-block: 10px;
    padding-inline: 16px;
  }

  /* Logo posé sur un pavé blanc, légèrement en surplomb du bandeau (référence maquette) :
     reste lisible quel que soit le fond, bleu nuit profond comme sur le héros ou crème ailleurs. */
  .site-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    background: var(--crn-blanc);
    border-radius: var(--radius-card-sm);
    padding: 6px 12px;
    margin-bottom: -12px;
    box-shadow: var(--shadow-card);
    position: relative;
    z-index: 3;
  }

  .site-header__brand :global(img) {
    height: 40px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-1);
  }

  /* Pilule à avatar rond (modèle de référence) : seul élément primaire de l'écran (règle « un
     seul bouton primaire »), fond en dégradé bleu nuit cerclé d'un liseré or pour une colorimétrie
     plus marquée — jamais l'or en aplat de bouton (règle GBIS absolue), même si le modèle de
     référence montre un fond or : seul le petit avatar circulaire reprend l'or, pas tout le fond. */
  .site-header__badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 5px 16px 5px 5px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
    border: 1.5px solid var(--crn-or-lumiere);
    color: var(--crn-blanc);
    text-decoration: none;
    box-shadow: 0 12px 26px -10px rgba(26, 44, 91, 0.65), 0 0 0 4px rgba(217, 196, 138, 0.1);
    transition: transform var(--transition-standard), background-color var(--transition-standard), box-shadow var(--transition-standard), border-color var(--transition-standard);
  }

  .site-header__badge-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--crn-or);
    color: var(--crn-bleu-nuit-profond);
  }

  .site-header__badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-align: left;
  }

  /* Focus clavier : anneau or profond détaché par un liseré blanc, lisible aussi bien sur
     l'en-tête blanc (or profond 4,9:1) que posé sur la photo sombre du héros (liseré blanc). */
  .site-header__badge:focus-visible {
    outline: 3px solid var(--crn-or-profond);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px var(--crn-blanc);
  }

  /* Sous 768 px : libellé court « La boutique » seul (place comptée, et rien sous 16 px) ; le
     lien s'annonce partout « Accédez à la Boutique de la Convention » (aria-label). */
  .site-header__badge-label,
  .site-header__badge-long {
    display: none;
  }

  .site-header__badge-label {
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--crn-or-lumiere);
  }

  .site-header__badge-value {
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 17px;
    white-space: nowrap;
  }

  /* Très petits écrans (< 360 px) : pilule réduite à son pictogramme, le texte reste lu. */
  @media (max-width: 359px) {
    .site-header__badge {
      padding: 4px;
      height: 50px;
    }

    .site-header__badge-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 640px) {
    .site-header__inner {
      gap: var(--space-2);
      padding-block: var(--space-2);
      padding-inline: var(--gutter-mobile);
    }

    .site-header__brand {
      flex-shrink: 0;
      padding: 10px 18px;
      margin-bottom: -22px;
    }

    .site-header__brand :global(img) {
      height: 60px;
    }

    .site-header__actions {
      gap: var(--space-2);
    }

    .site-header__badge {
      gap: 14px;
      height: 70px;
      padding: 8px 24px 8px 8px;
    }

    .site-header__badge-icon {
      width: 54px;
      height: 54px;
    }

    .site-header__badge-value {
      font-size: 19px;
    }
  }

  @media (min-width: 768px) {
    .site-header__badge-label,
    .site-header__badge-long {
      display: inline;
    }

    .site-header__badge-short {
      display: none;
    }
  }

  .site-header__badge:hover {
    background: linear-gradient(135deg, var(--crn-bleu-nuit-profond) 0%, var(--crn-bleu-nuit-profond) 100%);
    border-color: var(--crn-or);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 16px 32px -10px rgba(26, 44, 91, 0.75), 0 0 0 5px rgba(217, 196, 138, 0.16);
  }

  .site-header__toggle {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text);
    position: relative;
  }

  .site-header__toggle-bar::before {
    content: '';
    position: absolute;
    top: -6px;
  }

  .site-header__toggle-bar::after {
    content: '';
    position: absolute;
    top: 6px;
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    transition: transform var(--transition-standard), background-color var(--transition-standard);
  }

  /* Menu ouvert : les trois traits deviennent une croix (fermer). */
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar {
    background: transparent;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar::before {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* L'en-tête posé sur le héros redevient opaque dès que le menu est ouvert : menu et croix
     restent lisibles quelle que soit l'image dessous. */
  .site-header--overlay.has-open-nav {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 1px 0 rgba(16, 16, 16, 0.06);
  }

  .site-header--overlay.has-open-nav .site-header__toggle {
    border-color: var(--color-border);
    background: none;
  }

  .site-header--overlay.has-open-nav .site-header__toggle-bar::before,
  .site-header--overlay.has-open-nav .site-header__toggle-bar::after {
    background: var(--color-text);
  }

  /* Menu déroulant mobile : carte relevée (bord fin, ombre marquée, coin généreux), légère
     entrée animée (respecte prefers-reduced-motion via la règle globale). */
  .site-header__nav {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: var(--gutter-mobile);
    right: var(--gutter-mobile);
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
    padding: var(--space-1) var(--space-2);
    /* Toujours dans l'écran : défilement interne si le menu (sous-menu ouvert compris) est plus
       haut que l'espace restant sous l'en-tête. */
    max-height: calc(100vh - var(--site-header-h, 72px) - 24px);
    max-height: calc(100dvh - var(--site-header-h, 72px) - 24px);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .site-header__nav.is-open {
    display: block;
    animation: site-header-nav-in 0.22s ease;
  }

  @keyframes site-header-nav-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .site-header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .site-header__nav li + li {
    border-top: 1px solid var(--crn-gris-clair);
  }

  .site-header__nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2);
    color: var(--crn-noir);
    text-decoration: none;
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 18px;
    min-height: var(--tap-target-min);
    transition: background-color var(--transition-standard), color var(--transition-standard), padding-left var(--transition-standard);
  }

  .site-header__nav a :global(.icon) {
    flex-shrink: 0;
    color: var(--crn-or);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-standard), transform var(--transition-standard);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    background: var(--crn-creme);
    color: var(--crn-bleu-nuit);
    padding-left: calc(var(--space-2) + 6px);
  }

  .site-header__nav a:hover :global(.icon),
  .site-header__nav a:focus-visible :global(.icon) {
    opacity: 1;
    transform: translateX(0);
  }

  .site-header__nav a[aria-current='page'] {
    background: var(--crn-creme);
    color: var(--crn-bleu-nuit);
    box-shadow: inset 3px 0 0 var(--crn-or);
  }

  .site-header__nav a[aria-current='page'] :global(.icon) {
    opacity: 1;
    transform: translateX(0);
  }

  /* Déclencheur « Multimédia » : même apparence que les liens du menu mobile, mais un <button>
     (sous-menu, pas une destination directe). */
  .site-header__nav-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2);
    background: none;
    border: none;
    color: var(--crn-noir);
    text-decoration: none;
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 18px;
    min-height: var(--tap-target-min);
    cursor: pointer;
    text-align: left;
    transition: background-color var(--transition-standard), color var(--transition-standard), padding-left var(--transition-standard);
  }

  .site-header__nav-trigger :global(.icon) {
    flex-shrink: 0;
    color: var(--crn-or);
    transition: transform var(--transition-standard);
  }

  /* Même animation de survol que les autres liens du menu déroulant mobile (décalage du texte,
     fond crème) ; seul le chevron garde son rôle propre (rotation = sous-menu ouvert ou non). */
  .site-header__nav-trigger:hover,
  .site-header__nav-trigger:focus-visible {
    background: var(--crn-creme);
    color: var(--crn-bleu-nuit);
    padding-left: calc(var(--space-2) + 6px);
  }

  .site-header__nav-item.is-open .site-header__nav-trigger {
    background: var(--crn-creme);
    color: var(--crn-bleu-nuit);
  }

  .site-header__nav-item.is-open .site-header__nav-trigger :global(.icon) {
    transform: rotate(180deg);
  }

  /* Sous-menu mobile : accordéon en ligne (pas de pilule flottante), indenté et teinté pour se
     distinguer des catégories principales. */
  .site-header__submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0 0 4px var(--space-2);
    background: var(--crn-creme);
  }

  .site-header__nav-item.is-open .site-header__submenu {
    display: flex;
    flex-direction: column;
  }

  /* Fermé tant que « Multimédia » n'est pas touché : sans ce sélecteur plus spécifique, la règle
     générique `.site-header__nav ul { display: flex }` l'emportait et le sous-menu restait
     toujours déplié sur mobile. */
  .site-header__nav-item:not(.is-open) .site-header__submenu {
    display: none;
  }

  .site-header__submenu a {
    font-size: 16px;
    min-height: 40px;
    padding-block: var(--space-1);
  }

  @media (min-width: 1024px) {
    .site-header__toggle {
      display: none;
    }

