---
import { Image } from 'astro:assets';
import Icon from '../shared/Icon.astro';
import { hotline } from '../../lib/contact';
import { reseauxSociaux } from '../../lib/social';
import emblemes from '../../assets/images/emblemes-dores-convention-2026.png';
const annee = new Date().getFullYear();
---

<footer class="site-footer">
  <a class="site-footer__top" href="#contenu-principal" aria-label="Retour en haut de page">
    <Icon name="arrow-up" size={18} />
  </a>
  <div class="container site-footer__grid">
    <!-- Bloc identité : double logo (emblème CRN + logo de la Convention, même fichier que
         l'en-tête), accroche, contacts directs (hotline : appel et WhatsApp ; e-mail) puis tous
         les réseaux sociaux du CRN. -->
    <div class="site-footer__brand">
      <h2 class="visually-hidden">Convention CRN 2026</h2>
      <a class="site-footer__logo" href="/" aria-label="Convention CRN 2026 — accueil">
        <Image src={emblemes} alt="" width={240} height={96} loading="lazy" />
      </a>
      <p class="text-s">Du Trône à l’autel, de l’autel à la cité<br />6 – 13 décembre 2026 · Libreville, Gabon</p>

      <ul class="site-footer__contacts">
        <li>
          <Icon name="phone" size={18} />
          <span>
            <span class="site-footer__contact-label">Hotline</span>
            <a href={hotline.tel} aria-label={`Appeler la hotline, ${hotline.affichage}`}>{hotline.affichage}</a>
            <a
              class="site-footer__whatsapp"
              href={hotline.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Écrire à la hotline sur WhatsApp, ${hotline.affichage} (nouvel onglet)`}
            >
              <Icon name="whatsapp" size={18} />
              <span aria-hidden="true">WhatsApp</span>
            </a>
          </span>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <span>
            <span class="site-footer__contact-label">E-mail</span>
            <a href="mailto:contact@crn-convention2026.events">contact@crn-convention2026.events</a>
          </span>
        </li>
      </ul>

      <ul class="site-footer__social" aria-label="Réseaux sociaux du CRN">
        {reseauxSociaux.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={`${r.label} (nouvel onglet)`}>
              <Icon name={r.name} size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Liens du pied de page">
      <h3 class="site-footer__heading">Navigation</h3>
      <ul class="site-footer__list">
        <li><a href="/programme">Programme</a></li>
        <li><a href="/orateurs">Orateurs</a></li>
        <li><a href="/artistes">Artistes</a></li>
        <li><a href="/billetterie">Billetterie</a></li>
        <li><a href="/infos-pratiques">Infos pratiques</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
    </nav>

    <div>
      <h3 class="site-footer__heading">Contact</h3>
      <ul class="site-footer__list">
        <li><a href="/contact">Nous contacter</a></li>
        <li><a href="/nasty">Discuter avec NASTY</a></li>
        <li class="site-footer__placeholder">CRN International <span class="text-s">(lien à renseigner)</span></li>
      </ul>
    </div>

    <div>
      <h3 class="site-footer__heading">Mentions</h3>
      <ul class="site-footer__list">
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/confidentialite">Confidentialité</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom text-s">
    <div class="site-footer__bottom-text">
      <p>© {annee} Ministères Christ Révélé aux Nations (CRN). Tous droits réservés.</p>
      <p>Site officiel de la Convention CRN 2026 · Libreville, Gabon</p>
    </div>
    <a class="site-footer__credit" href="https://axxion.consulting/" target="_blank" rel="noopener noreferrer">
      Powered by <span>AXXION CONSULTING</span>
    </a>
  </div>

  <p class="site-footer__ghost" aria-hidden="true" data-text="CONVENTION CRN 2026"></p>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--crn-bleu-nuit-profond);
    color: rgba(255, 255, 255, 0.78);
    padding-block: var(--space-6);
    overflow: hidden;
  }

  /* Repositionné à l'intérieur du pied de page (auparavant à moitié flottant au-dessus, dans la
     marge vide qui précédait le footer — désormais occupée par la bande « Écosystème digital
     CRN » ; flottant plus haut, il se faisait couper par l'overflow:hidden du footer). */
  .site-footer__top {
    position: absolute;
    top: var(--space-3);
    right: var(--gutter-mobile);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
    box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.5);
    border: 2px solid var(--crn-bleu-nuit-profond);
  }

  .site-footer__top:hover {
    background: var(--crn-or);
    color: var(--crn-noir);
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      right: var(--gutter-desktop);
    }
  }

  .site-footer__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  /* Bloc identité (logo, contacts, réseaux) sur toute la largeur en tablette, puis colonne
     élargie sur grand écran : l'adresse e-mail tient sur une ligne. */
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }

  /* Double logo sur pavé blanc (comme dans l'en-tête) : lisible sur le bleu nuit profond. */
  .site-footer__logo {
    display: inline-flex;
    background: var(--crn-blanc);
    border-radius: var(--radius-card-sm);
    padding: 10px 18px;
    margin-bottom: var(--space-2);
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.6);
  }

  .site-footer__logo :global(img) {
    display: block;
    height: 64px;
    width: auto;
  }

  .site-footer__brand > p {
    margin: 0 0 var(--space-3) 0;
  }

  .site-footer__contacts {
    list-style: none;
    margin: 0 0 var(--space-3) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__contacts > li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .site-footer__contacts > li > :global(.icon) {
    margin-top: 3px;
    color: var(--crn-or-lumiere);
  }

  .site-footer__contacts > li > span {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2);
    row-gap: 2px;
    min-width: 0;
  }

  .site-footer__contact-label {
    flex-basis: 100%;
    font-size: var(--text-s);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--crn-or-lumiere);
  }

  .site-footer__contacts a {
    color: var(--crn-blanc);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .site-footer__contacts a:hover,
  .site-footer__contacts a:focus-visible {
    text-decoration: underline;
  }

  .site-footer__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Réseaux sociaux : pastilles au trait sur fond sombre ; au survol, fond or lumière et
     pictogramme bleu nuit (jamais de blanc sur or — règle GBIS). */
  .site-footer__social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--crn-blanc);
    transition: background-color var(--transition-standard), color var(--transition-standard), border-color var(--transition-standard), transform var(--transition-standard);
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    background: var(--crn-or-lumiere);
    border-color: var(--crn-or-lumiere);
    color: var(--crn-bleu-nuit-profond);
    transform: translateY(-2px);
  }

  .site-footer__heading {
    font-family: var(--font-labeur);
    font-size: var(--text-s);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--crn-or-lumiere);
    margin-bottom: var(--space-1);
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .site-footer__list a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .site-footer__list a:hover {
    text-decoration: underline;
  }

  .site-footer__placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .site-footer__bottom {
    position: relative;
    z-index: 1;
    margin-top: var(--space-6);
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.55);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .site-footer__bottom-text p {
    margin: 0;
  }

  .site-footer__credit {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-standard);
  }

  .site-footer__credit span {
    font-weight: 700;
    color: rgba(255, 255, 255, 0.78);
    transition: color var(--transition-standard);
  }

  .site-footer__credit:hover,
  .site-footer__credit:hover span {
    color: var(--crn-or-lumiere);
  }

  .site-footer__ghost {
    position: relative;
    z-index: 0;
    margin: var(--space-3) 0 calc(-1 * var(--space-6)) 0;
    text-align: center;
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: clamp(28px, 6vw, 62px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(217, 196, 138, 0.12);
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  /* Filigrane purement décoratif (WCAG 1.4.3 : aucune exigence de contraste pour la décoration) :
     le texte est généré en CSS plutôt que placé dans le DOM, où les outils d'audit le traiteraient
     comme du contenu à contraster. */
  .site-footer__ghost::before {
    content: attr(data-text);
  }
</style>
