---
import { Image } from 'astro:assets';
import { formatEUR, formatXAF } from '../../lib/boutique';
import type { VisuelPlateforme } from '../../lib/visuels-plateformes';

interface Props {
  nom: string;
  prixFCFA: number | null;
  description: string;
  /** Fiche produit de la boutique (LOT A, A3). */
  lienAchat?: string;
  statut: 'disponible' | 'complet' | 'a_annoncer';
  featured?: boolean;
  /** Vignette en tête de carte (B-02) ; null : cadre neutre marqué, en attente du visuel. */
  visuel?: VisuelPlateforme | null;
}
const { nom, prixFCFA, description, lienAchat, statut, featured = false, visuel } = Astro.props;

const prixAffiche = prixFCFA === null ? 'À annoncer' : formatXAF(prixFCFA);
---

<article class={`price-card ${featured ? 'price-card--featured' : ''}`}>
  {visuel !== undefined && (
    <div class="price-card__visuel">
      {visuel ? (
        <Image src={visuel.image} alt="" widths={[400, 640]} sizes="(min-width: 1224px) 380px, (min-width: 1024px) 30vw, (min-width: 768px) 46vw, 92vw" loading="lazy" />
      ) : (
        <span class="price-card__sigle" aria-hidden="true">CRN</span>
      )}
    </div>
  )}
  {featured && <span class="price-card__flag">Recommandé</span>}
  <div class="price-card__head">
    <h4 class="price-card__name">{nom}</h4>
    {statut === 'complet' && <span class="price-card__badge">Complet</span>}
  </div>
  <p class="price-card__price">
    {prixAffiche}
    {prixFCFA !== null && <span class="price-card__eur">soit {formatEUR(prixFCFA)}</span>}
  </p>
  {statut !== 'a_annoncer' && <p class="price-card__description">{description}</p>}
  {statut === 'disponible' && lienAchat && (
    <a class={`button price-card__cta ${featured ? 'price-card__cta--on-dark' : 'button--secondary'}`} href={lienAchat} aria-label={`Voir dans la boutique\u00a0: ${nom}`}>Voir dans la boutique</a>
  )}
  {statut === 'complet' && <p class="price-card__note">Ce produit est actuellement complet.</p>}
  {statut === 'a_annoncer' && <p class="price-card__note">Contenu et tarif à annoncer.</p>}
</article>

<style>
  .price-card {
    position: relative;
    border: var(--border-width-rest) solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    transition: transform var(--transition-standard), box-shadow var(--transition-standard);
  }

  /* Vignette pleine largeur en tête de carte, coins hauts arrondis comme la carte. */
  .price-card__visuel {
    aspect-ratio: 16 / 9;
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) var(--space-1);
    border-radius: calc(var(--radius-card) - 1px) calc(var(--radius-card) - 1px) 0 0;
    border-bottom: 2px solid var(--crn-or);
    overflow: hidden;
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .price-card__visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .price-card__sigle {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: 25px;
    letter-spacing: 0.12em;
    color: var(--crn-or);
    border: 1px solid var(--crn-or);
    padding: 6px 14px;
  }

  .price-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  /* Carte recommandée : fond bleu nuit, filet or ; jamais l'or en aplat (règle absolue GBIS). */
  .price-card--featured {
    background: var(--crn-bleu-nuit);
    border-color: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
    box-shadow: var(--shadow-lift);
  }

  .price-card__flag {
    position: absolute;
    top: -12px;
    left: var(--space-3);
    background: var(--crn-or);
    color: var(--crn-noir);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .price-card__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .price-card__name {
    font-size: var(--text-h4-mobile);
    margin: 0;
  }

  .price-card--featured .price-card__name {
    color: var(--crn-blanc);
  }

  .price-card__badge {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
  }

  .price-card__price {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: var(--text-h3-mobile);
    /* Jamais de texte or sur fond clair (règle absolue GBIS). Sur la carte recommandée (fond
       bleu nuit), l'or lumière passe le seuil de contraste en grand corps. */
    color: var(--crn-bleu-nuit);
    margin: 0;
  }

  .price-card--featured .price-card__price {
    color: var(--crn-or);
  }

  .price-card__eur {
    display: block;
    font-family: var(--font-labeur);
    font-weight: 400;
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .price-card--featured .price-card__eur {
    color: rgba(255, 255, 255, 0.8);
  }

  .price-card__description {
    color: var(--color-text-muted);
    margin: 0;
    flex-grow: 1;
  }

  .price-card--featured .price-card__description {
    color: rgba(255, 255, 255, 0.8);
  }

  .price-card__cta {
    margin-top: var(--space-1);
    align-self: flex-start;
  }

  .price-card__cta--on-dark {
    background: var(--crn-blanc);
    color: var(--crn-bleu-nuit);
  }

  /* Jamais l'or en aplat de bouton (règle absolue GBIS), y compris au survol. */
  .price-card__cta--on-dark:hover {
    background: var(--crn-creme);
  }

  .price-card__note {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    font-style: italic;
    margin: var(--space-1) 0 0 0;
  }

  .price-card--featured .price-card__note {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
