---
/*
  Modal vidéo partagé, unique sur la page, déclenché par tout élément portant
  [data-video-modal-trigger] + [data-video-src="/chemin/vers/video.mp4"] (+ facultatif
  [data-video-poster="/chemin/vers/affiche.jpg"]) (le bouton « Voir le
  film » du héros, celui de la section Film…). La vidéo n'est chargée qu'à l'ouverture — rien
  n'est ajouté au poids de la page tant que personne ne clique (NF-CNV-001/budget de performance).
  Fermeture : bouton dédié, clic sur le fond, touche Échap ; le focus revient au déclencheur.
*/
import Icon from './Icon.astro';
---

<div class="video-modal" id="video-modal" role="dialog" aria-modal="true" aria-label="Lecteur vidéo" hidden>
  <div class="video-modal__backdrop" data-video-modal-close aria-hidden="true"></div>
  <div class="video-modal__panel">
    <button type="button" class="video-modal__close" data-video-modal-close aria-label="Fermer la vidéo">
      <Icon name="x" size={20} />
    </button>
    <video class="video-modal__video" id="video-modal-player" controls playsinline></video>
  </div>
</div>

<script>
  const modal = document.getElementById('video-modal');
  const video = document.getElementById('video-modal-player') as HTMLVideoElement | null;
  let lastFocused: HTMLElement | null = null;

  function onKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') closeModal();
  }

  function openModal(src: string, trigger: HTMLElement) {
    if (!modal || !video) return;
    lastFocused = trigger;
    // Affiche montrée pendant le chargement (au lieu d'un cadre noir), surtout en 3G.
    const poster = trigger.getAttribute('data-video-poster');
    if (poster) video.poster = poster;
    else video.removeAttribute('poster');
    video.src = src;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    video.play().catch(() => {
      /* la lecture auto peut être refusée selon le navigateur ; les contrôles restent utilisables */
    });
    modal.querySelector<HTMLButtonElement>('.video-modal__close')?.focus();
    document.addEventListener('keydown', onKeydown);
  }

  function closeModal() {
    if (!modal || !video) return;
    modal.hidden = true;
    video.pause();
    video.removeAttribute('src');
    video.load();
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-video-modal-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      const src = trigger.getAttribute('data-video-src');
      if (!src) return;
      e.preventDefault();
      openModal(src, trigger);
    });
  });

  modal?.querySelectorAll<HTMLElement>('[data-video-modal-close]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });
</script>

<style>
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
  }

  .video-modal[hidden] {
    display: none;
  }

  .video-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 16, 34, 0.88);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .video-modal__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-modal__video {
    width: 100%;
    max-height: 80vh;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
    background: var(--crn-noir);
  }

  .video-modal__close {
    position: absolute;
    top: -56px;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--crn-blanc);
    color: var(--crn-bleu-nuit);
    border: none;
    cursor: pointer;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-standard), background-color var(--transition-standard);
  }

  .video-modal__close:hover,
  .video-modal__close:focus-visible {
    background: var(--crn-creme);
    transform: scale(1.06);
  }

  @media (max-width: 640px) {
    .video-modal__close {
      top: auto;
      bottom: calc(100% - 44px);
      right: 4px;
    }
  }
</style>
