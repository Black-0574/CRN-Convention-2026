---
interface Item {
  question: string;
  reponse: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="faq-accordion" data-reveal-group>
  {items.map((item) => (
    <details class="faq-item" name="faq">
      <summary class="faq-item__question">
        <span>{item.question}</span>
        <span class="faq-item__icon" aria-hidden="true">+</span>
      </summary>
      <p class="faq-item__answer">{item.reponse}</p>
    </details>
  ))}
</div>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .faq-item {
    border: var(--border-width-rest) solid var(--color-border);
    border-radius: var(--radius-card-sm);
    background: var(--color-bg-alt);
    padding: var(--space-2) var(--space-3);
    transition: background-color var(--transition-standard), border-color var(--transition-standard);
  }

  .faq-item[open] {
    background: var(--crn-bleu-nuit);
    border-color: var(--crn-bleu-nuit);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    cursor: pointer;
    font-family: var(--font-labeur);
    font-weight: 700;
    list-style: none;
    min-height: var(--tap-target-min);
  }

  .faq-item[open] .faq-item__question {
    color: var(--crn-blanc);
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--crn-or);
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h4-mobile);
    line-height: 1;
    transition: transform var(--transition-standard);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
    color: var(--crn-blanc);
    border-color: var(--crn-or);
  }

  .faq-item__answer {
    margin-top: var(--space-1);
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  .faq-item[open] .faq-item__answer {
    color: rgba(255, 255, 255, 0.82);
  }
</style>
