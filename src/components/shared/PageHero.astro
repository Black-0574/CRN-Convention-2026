---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from './Section.astro';
import Breadcrumb from './Breadcrumb.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  crumbs: Crumb[];
  /** Photo de fond du héros (document d'habillage : P-01, AC-01, O-01…) ; décorative. */
  image?: ImageMetadata;
}
const { eyebrow, title, intro, crumbs, image } = Astro.props;
---

<Section tone="feature" ariaLabel={title}>
  {image && (
    <div class="page-hero__fond" slot="fond">
      <Image src={image} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
  )}
  <Breadcrumb items={crumbs} inverse />
  <p class:list={['page-hero__eyebrow', { 'page-hero__eyebrow--sur-image': image }]} data-reveal>{eyebrow}</p>
  <h1 class="page-hero__title" data-reveal>{title}</h1>
  {intro && <p class:list={['page-hero__intro', { 'page-hero__intro--sur-image': image }]} data-reveal>{intro}</p>}
</Section>

<style>
  /* Photo sous un voile bleu nuit plus dense à gauche (côté texte) : contraste du blanc et de l'or
     garanti quelle que soit la photo. Les particules dorées de la section restent par-dessus. */
  .page-hero__fond {
    position: absolute;
    inset: 0;
  }

  /* Sujet des photos de héros composé à droite (texte à gauche) : cadrage décalé vers la droite,
     sensible sur mobile où le héros est étroit. */
  .page-hero__fond img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .page-hero__fond::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(22, 36, 74, 0.73);
  }

  @media (min-width: 768px) {
    .page-hero__fond::after {
      background: linear-gradient(90deg, rgba(22, 36, 74, 0.79) 0%, rgba(22, 36, 74, 0.67) 50%, rgba(22, 36, 74, 0.42) 100%);
    }
  }

  /* Sur photo, voile allégé à la demande du Commanditaire : l'or garde son contraste (≥ 3:1, gros
     texte) grâce à une pastille bleu nuit derrière l'étiquette seule. */
  .page-hero__eyebrow--sur-image {
    display: inline-block;
    padding: 2px 14px;
    background: rgba(22, 36, 74, 0.78);
    border-radius: var(--radius-pill);
  }

  /* Chapô en blanc plein sur photo : contraste ≥ 4,5:1 mesuré sur toutes les pages. */
  .page-hero__intro.page-hero__intro--sur-image {
    color: var(--crn-blanc);
  }

  .page-hero__eyebrow {
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--crn-or);
    margin: 0 0 var(--space-1) 0;
  }

  .page-hero__title {
    color: var(--crn-blanc);
    margin: 0 0 var(--space-2) 0;
  }

  .page-hero__intro {
    max-width: 65ch;
    font-size: var(--text-p);
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }
</style>
