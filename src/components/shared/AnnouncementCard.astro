---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { visuelActualite } from '../../lib/visuels-actualites';

interface Props {
  categorie: string;
  icone: IconName;
  date: string;
  dateISO: string;
  titre: string;
  texte: string;
  lienHref?: string;
  lienLabel?: string;
  /** Vignette à gauche au lieu d'une bande en tête (colonne étroite de l'accueil). */
  compacte?: boolean;
}
const { categorie, icone, date, dateISO, titre, texte, lienHref, lienLabel, compacte = false } = Astro.props;
// Vignette de la rubrique (A-12, N-02) ; décorative, le titre nomme l'actualité.
const visuel = visuelActualite(categorie);
---

<article class:list={['announcement-card', { 'announcement-card--compacte': compacte && visuel }]} data-categorie={categorie}>
  {visuel && (
    <div class="announcement-card__visuel">
      {compacte ? (
        <Image src={visuel} alt="" widths={[240, 400]} sizes="(min-width: 768px) 140px, 92vw" loading="lazy" />
      ) : (
        <Image src={visuel} alt="" widths={[400, 640, 900]} sizes="(min-width: 1224px) 380px, (min-width: 768px) 45vw, 92vw" loading="lazy" />
      )}
    </div>
  )}
  <div class="announcement-card__head">
    <span class="announcement-card__icon"><Icon name={icone} size={22} /></span>
    <span class="announcement-card__tag">{categorie}</span>
  </div>
  <time class="announcement-card__date" datetime={dateISO}>{date}</time>
  <h3 class="announcement-card__title">{titre}</h3>
  <p class="announcement-card__text">{texte}</p>
  {lienHref && (
    <a class="announcement-card__link" href={lienHref}>
      {lienLabel ?? 'En savoir plus'} <Icon name="arrow-right" size={14} />
    </a>
  )}
</article>

<style>
  .announcement-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-3);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    border-top: 3px solid var(--crn-or);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-standard), box-shadow var(--transition-standard), border-color var(--transition-standard);
  }

  .announcement-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: var(--crn-or);
  }

  /* Bande d'image pleine largeur en tête de carte (marges de la carte annulées). */
  .announcement-card__visuel {
    aspect-ratio: 16 / 9;
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) var(--space-2);
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    border-bottom: 2px solid var(--crn-or);
    background: var(--crn-bleu-nuit);
  }

  .announcement-card__visuel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-standard);
  }

  .announcement-card:hover .announcement-card__visuel img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-card:hover .announcement-card__visuel img {
      transform: none;
    }
  }

  /* Variante compacte : bande en tête sur mobile, vignette à gauche dès 768 px. */
  @media (min-width: 768px) {
    .announcement-card--compacte {
      display: grid;
      grid-template-columns: 140px 1fr;
      column-gap: var(--space-2);
      align-content: start;
    }

    .announcement-card--compacte > * {
      grid-column: 2;
    }

    .announcement-card--compacte .announcement-card__visuel {
      grid-column: 1;
      grid-row: 1 / span 6;
      align-self: start;
      aspect-ratio: 4 / 3;
      margin: 0;
      border: 1.5px solid var(--crn-or);
      border-radius: var(--radius-card);
    }
  }

  .announcement-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .announcement-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
    border: 1.5px solid var(--crn-or);
    color: var(--crn-or);
  }

  .announcement-card__tag {
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: var(--text-s);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--crn-bleu-nuit);
    background: var(--crn-creme);
    border: 1px solid var(--crn-or);
    border-radius: var(--radius-pill);
    padding: 3px 12px;
  }

  .announcement-card__date {
    display: block;
    font-size: var(--text-s);
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .announcement-card__title {
    font-size: var(--text-h4-mobile);
    margin: 0 0 var(--space-1) 0;
  }

  .announcement-card__text {
    margin: 0;
    color: var(--color-text-muted);
    flex: 1;
  }

  .announcement-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--crn-bleu-nuit);
    text-decoration: none;
  }

  .announcement-card__link:hover {
    text-decoration: underline;
  }

  .announcement-card__link :global(.icon) {
    transition: transform var(--transition-standard);
  }

  .announcement-card__link:hover :global(.icon) {
    transform: translateX(3px);
  }
</style>
