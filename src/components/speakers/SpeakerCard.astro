---
import Icon from '../shared/Icon.astro';

interface Props {
  nom: string;
  /** Catégorie d'orateur affichée sous le nom ; pour un artiste, `role` la remplace. */
  categorie?: 'hote' | 'international' | 'national' | 'prophetique' | 'plateforme';
  role?: string;
  photo?: string;
  href?: string;
  /** Masque le nom/rôle sous la photo — pour la fiche détaillée, où ils sont déjà affichés
      à côté (évite la répétition). */
  hideCaption?: boolean;
}
const { nom, categorie, role, photo, href, hideCaption = false } = Astro.props;

const labels: Record<NonNullable<Props['categorie']>, string> = {
  hote: 'Hôte',
  international: 'Orateur international',
  national: 'Orateur national',
  prophetique: 'Ministère prophétique',
  plateforme: 'Intervenante de plateforme',
};

const initiales = nom
  .split(' ')
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();

const Tag = href ? 'a' : 'div';
---

<Tag class="speaker-card" href={href}>
  <div class="speaker-card__ring" aria-hidden="true">
    <div class="speaker-card__frame">
      {photo ? <img src={photo} alt="" width="480" height="640" loading="lazy" /> : <span>{initiales}</span>}
    </div>
    <span class="speaker-card__badge"><Icon name="camera" size={16} /></span>
  </div>
  {!photo && <p class="speaker-card__note" aria-hidden="true">Photo réelle à fournir</p>}
  {!hideCaption && (
    <>
      <p class="speaker-card__name">{nom}</p>
      {(role ?? (categorie && labels[categorie])) && <p class="speaker-card__role">{role ?? (categorie && labels[categorie])}</p>}
    </>
  )}
</Tag>

<style>
  .speaker-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .speaker-card__ring {
    position: relative;
    padding: 10px;
    border: 1.5px dashed var(--crn-or);
    border-radius: 50% 50% var(--radius-card) var(--radius-card);
    margin-bottom: var(--space-2);
    transition: transform var(--transition-standard), border-color var(--transition-standard);
  }

  .speaker-card:hover .speaker-card__ring,
  .speaker-card:focus-visible .speaker-card__ring {
    transform: translateY(-4px);
    border-color: var(--crn-or-lumiere);
  }

  /* Cadre en attente de photo réelle : dégradé bleu nuit (plutôt qu'un aplat) et initiales en
     plus grand corps, pour une présence plus soignée tant que la photo n'est pas fournie. */
  .speaker-card__frame {
    aspect-ratio: 3 / 4;
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
    color: var(--crn-blanc);
    border-radius: 50% 50% var(--radius-card-sm) var(--radius-card-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .speaker-card__frame span {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: var(--text-h2);
    letter-spacing: 0.04em;
  }

  .speaker-card__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  /* Médaillon or en bas à gauche du cadre (modèle de référence), icône appareil photo pour
     signaler qu'une vraie photo prendra cette place. */
  .speaker-card__badge {
    position: absolute;
    bottom: 4px;
    left: 4px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--crn-or) 0%, var(--crn-or-profond) 100%);
    color: var(--crn-blanc);
    border: 2px solid var(--crn-blanc);
    box-shadow: var(--shadow-card);
  }

  .speaker-card__note {
    font-size: var(--text-s);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--color-text-muted);
    opacity: 0.8;
    margin: 0 0 var(--space-1) 0;
  }

  .speaker-card__name {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: var(--text-h4-mobile);
    margin: 0;
    text-align: center;
  }

  .speaker-card__role {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    margin: 0;
    text-align: center;
  }
</style>
