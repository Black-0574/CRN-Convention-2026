---
import { Image } from 'astro:assets';
import Countdown from './Countdown.astro';
import Button from '../shared/Button.astro';
import Icon from '../shared/Icon.astro';
import heroImage from '../../assets/images/hero-venue-2.webp';
import heroSpeaker from '../../assets/images/hero-orateur-1.webp';
import { lienBoutique } from '../../lib/boutique';

const cibleISO = '2026-12-06T09:00:00+01:00';
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__bg"
    src={heroImage}
    alt=""
    width={1983}
    height={793}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">Convention CRN 2026</p>
      <h1 id="hero-title" class="hero__title">Du Trône à l'autel, de l'autel à la cité.</h1>

      <p class="hero__meta">
        <span class="hero__meta-item"><Icon name="calendar" size={24} /> 6 – 13 décembre 2026</span>
        <span class="hero__meta-sep">·</span>
        <span class="hero__meta-item"><Icon name="pin" size={24} /> Libreville, Gabon</span>
      </p>

      <p class="hero__description">
        Une semaine de rencontre, d'enseignement, de consécration et d'engagement pour notre
        génération.
      </p>

      <!-- Rangée « compte à rebours + film » : sur mobile, le bouton du film se range au bout de la
           rangée du compte à rebours (jamais par-dessus « SEC », quelle que soit la largeur) ; à
           partir de 1024 px la rangée s'efface (display: contents) et le bouton reprend sa
           composition flottante, repérée sur .hero__inner. -->
      <div class="hero__countdown-row">
        <Countdown cibleISO={cibleISO} />

        <a
          class="hero__video-cta"
          href="#film"
          aria-label="Voir le film de la Convention"
          data-video-modal-trigger
          data-video-src="/videos/film-convention-crn-2026-720p.mp4"
          data-video-poster="/videos/film-convention-crn-2026-affiche.jpg"
        >
          <Icon name="play" size={18} />
          <span class="hero__video-label">Voir le film</span>
        </a>
      </div>

      <div class="hero__actions">
        <Button href={lienBoutique('accueil-heros')} variant="secondary">Prendre mon pass <Icon name="arrow-right" size={16} /></Button>
        <Button href="/programme" variant="secondary">Voir le programme</Button>
        <p class="hero__badge"><Icon name="pin" size={14} /> Libreville, Gabon</p>
      </div>
    </div>
  </div>

  <Image
    class="hero__speaker"
    src={heroSpeaker}
    alt=""
    width={820}
    height={691}
    loading="eager"
  />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
    /* Remonte sous l'en-tête transparent pour que le pavé du logo et la grille de navigation
       paraissent posés sur l'image du héros. --site-header-h = hauteur réelle mesurée
       (Header.astro) ; une valeur fixe laissait une bande du fond de page visible sous la barre
       du haut dès que l'en-tête était plus haut que prévu. */
    margin-top: calc(-1 * var(--site-header-h, 96px));
    padding-top: calc(var(--space-6) + var(--site-header-h, 96px));
    padding-bottom: var(--space-3);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Double voile : un dégradé vertical général + un voile horizontal concentré sous le texte
     (gauche), pour un contraste net quelle que soit la zone de l'image sous les écritures. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(10, 16, 34, 0.78) 0%, rgba(10, 16, 34, 0.5) 45%, rgba(10, 16, 34, 0.18) 72%, rgba(10, 16, 34, 0.3) 100%),
      linear-gradient(180deg, rgba(22, 36, 74, 0.38) 0%, rgba(22, 36, 74, 0.5) 55%, rgba(22, 36, 74, 0.68) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Entrée en cascade au chargement (fond et photo du héros inchangés, seul le texte « arrive »).
     CSS pur, sans dépendance JS ; prefers-reduced-motion neutralise la durée via la règle globale. */
  .hero__content > * {
    animation: hero-fade-up 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__content > *:nth-child(1) {
    animation-delay: 60ms;
  }

  .hero__content > *:nth-child(2) {
    animation-delay: 140ms;
  }

  .hero__content > *:nth-child(3) {
    animation-delay: 220ms;
  }

  .hero__content > *:nth-child(4) {
    animation-delay: 300ms;
  }

  .hero__content > *:nth-child(5) {
    animation-delay: 380ms;
  }

  .hero__content > *:nth-child(6) {
    animation-delay: 460ms;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Portrait de l'orateur : superposé sur l'immeuble (fond du héros), bleed sur le bord droit,
     déjà dans les limites du héros sur mobile — visible sans défiler, mêmes proportions que sur
     bureau (voir media query 1024 px). Sous le texte en z-index pour qu'il reste lisible.
     object-fit:cover (plutôt que contain) + haut épinglé au niveau du titre : avec une largeur
     étroite (mobile), « contain » laissait un grand vide au-dessus de la tête (l'image est quasi
     sans marge transparente, 2 % à peine) ; « cover » remplit tout le cadre, tête au ras du haut. */
  .hero__speaker {
    display: block;
    position: absolute;
    z-index: 1;
    top: 360px;
    bottom: 0;
    right: -4%;
    width: 78%;
    margin: 0;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
    filter: drop-shadow(0 16px 28px rgba(16, 16, 16, 0.35));
  }

  /* CTA « blob » (forme organique à un coin plat, modèle de référence) : ouvre le film de la
     Convention (14 s, 720p, ~1 Mo) dans le lecteur partagé (VideoModal.astro), comme le bouton de
     la section « Le film de la Convention » (FilmTeaser.astro) ; sans JS, renvoie à cette section.
     Écart signalé — or en aplat de bouton : ce médaillon est la SEULE exception sur tout le site à
     la règle GBIS « jamais l'or en aplat de bouton », décidée à la demande explicite de
     l'utilisateur (confirmée après qu'il a vu le fond bleu nuit se fondre dans le veston de
     l'orateur) : le contraste or sur fond sombre fait ressortir le bouton au lieu de s'y
     camoufler. Tous les autres CTA du site restent en bleu nuit. Voir docs/conformite.md.
     Sur mobile, le héros n'a aucune colonne libre (tout le texte occupe toute la largeur) : pas
     de place pour la faire flotter dans un coin sans chevaucher un libellé. Placée au niveau du
     compte à rebours, juste à droite — devant l'orateur sans être sur lui ni derrière lui
     (demande explicite) — plutôt que dans la rangée de boutons : elle fait partie de la même
     rangée flex que le compte à rebours (une position fixe en pixels finissait sur « SEC » dès
     que le texte au-dessus passait sur une ligne de plus), et passe à la ligne, alignée à
     droite, sur les tout petits écrans. À partir de 1024 px, assez d'espace libère la pleine
     composition flottante avec son libellé, plus haut dans le héros. */
  .hero__countdown-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }

  /* Compte à rebours resserré (mobile seulement) pour laisser la place au bouton du film sur la
     même ligne dès 360 px de large. */
  @media (max-width: 1023px) {
    .hero__countdown-row > :global(.countdown) {
      flex: 0 1 auto;
      min-width: 0;
      gap: 10px;
    }

    .hero__countdown-row :global(.countdown__unit) {
      min-width: 44px;
    }
  }

  .hero__video-cta {
    position: relative;
    z-index: 3;
    flex-shrink: 0;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50% 50% 50% 14px;
    background: linear-gradient(135deg, var(--crn-or) 0%, var(--crn-or-profond) 100%);
    color: var(--crn-bleu-nuit-profond);
    text-decoration: none;
    border: 2px solid var(--crn-blanc);
    box-shadow: 0 10px 20px -10px rgba(16, 16, 16, 0.55);
    transition: transform var(--transition-standard), box-shadow var(--transition-standard), border-color var(--transition-standard);
    animation: hero-video-pulse 2.6s ease-in-out infinite;
  }

  .hero__video-cta:hover,
  .hero__video-cta:focus-visible {
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 14px 26px -10px rgba(16, 16, 16, 0.65);
    animation-play-state: paused;
  }

  /* Halo pulsé discret pour attirer l'œil sans gêner (respecte prefers-reduced-motion via la
     règle globale, qui neutralise animation-duration). */
  @keyframes hero-video-pulse {
    0%, 100% {
      box-shadow: 0 10px 20px -10px rgba(16, 16, 16, 0.55), 0 0 0 0 rgba(217, 196, 138, 0.5);
    }
    50% {
      box-shadow: 0 10px 20px -10px rgba(16, 16, 16, 0.55), 0 0 0 10px rgba(217, 196, 138, 0);
    }
  }

  /* Icône (et libellé, sur bureau) en bleu nuit : lisible sur le fond or, cohérent avec les
     autres badges or/bleu nuit du site (insigne du menu, bandeau d'icônes). */
  .hero__video-cta :global(.icon) {
    color: var(--crn-bleu-nuit-profond);
  }

  .hero__video-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__eyebrow {
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--crn-or);
    margin: 0 0 var(--space-1) 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 2px 10px rgba(0, 0, 0, 0.55);
  }

  .hero__title {
    color: var(--crn-blanc);
    font-size: 45px;
    margin: 0 0 var(--space-2) 0;
    max-width: 18ch;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95), 0 4px 18px rgba(0, 0, 0, 0.6);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin: 0 0 var(--space-2) 0;
    color: var(--crn-or);
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 24px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 2px 10px rgba(0, 0, 0, 0.55);
  }

  .hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero__meta-sep {
    opacity: 0.6;
  }

  .hero__description {
    max-width: 52ch;
    font-size: 23px;
    font-weight: 600;
    color: var(--crn-blanc);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 2px 12px rgba(0, 0, 0, 0.55);
    margin: 0 0 var(--space-3) 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-3);
  }

  .hero__actions :global(.button) {
    gap: 8px;
    padding: 0 18px;
  }

  .hero__actions :global(.button--secondary) {
    color: var(--crn-blanc);
    border-color: var(--crn-blanc);
  }

  /* Au survol : bascule vers l'or (accent, jamais en aplat de fond — règle GBIS), léger
     soulèvement et halo doré pour plus d'allure. */
  .hero__actions :global(.button--secondary:hover),
  .hero__actions :global(.button--secondary:focus-visible) {
    background: rgba(217, 196, 138, 0.14);
    color: var(--crn-or-lumiere);
    border-color: var(--crn-or-lumiere);
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 28px -14px rgba(217, 196, 138, 0.55);
  }

  .hero__actions :global(.button--secondary:hover .icon),
  .hero__actions :global(.button--secondary:focus-visible .icon) {
    transform: translateX(3px);
  }

  .hero__actions :global(.button--secondary .icon) {
    transition: transform var(--transition-standard);
  }

  /* Étiquette de lieu, non cliquable (simple <p>) — alignée dans la même rangée que les boutons
     du héros, jamais de hover ni de curseur pointeur, pour rester visuellement distincte des CTA. */
  .hero__badge {
    display: none;
    margin: 0;
    cursor: default;
  }

  @media (min-width: 1024px) {
    .hero {
      margin-top: calc(-1 * var(--site-header-h, 100px));
      padding-top: calc(var(--space-10) + var(--site-header-h, 100px));
      padding-bottom: var(--space-10);
      min-height: 640px;
      display: flex;
      align-items: center;
    }

    .hero__title {
      font-size: 56px;
    }

    /* Aligné avec la rangée du compte à rebours, dans l'espace libre entre « SEC » et l'orateur —
       devant lui, jamais sur lui. Entre 1024 et 1223 px, le conteneur de texte n'est pas encore
       plafonné à sa largeur maximale : cet espace libre se réduit à peine plus que la largeur du
       médaillon plein format, qui chevaucherait alors l'orateur. Taille intermédiaire ici ; la
       version pleine grandeur reprend au-delà de 1224 px (voir media query suivante), quand le
       conteneur se plafonne et que l'espace redevient large et stable à toute largeur d'écran. */
    /* La rangée mobile s'efface : le compte à rebours redevient un enfant direct du contenu (il
       reprend son entrée en cascade et son espacement d'origine) et le bouton du film flotte,
       repéré sur .hero__inner (.hero__content n'est pas positionné). */
    .hero__countdown-row {
      display: contents;
    }

    .hero__countdown-row > :global(.countdown) {
      gap: var(--space-3);
      animation: hero-fade-up 700ms cubic-bezier(0.22, 1, 0.36, 1) 300ms both;
    }

    .hero__video-cta {
      position: absolute;
      margin-left: 0;
      top: 513px;
      bottom: auto;
      left: 413px;
      right: auto;
      width: 90px;
      height: 90px;
      border-radius: 50% 50% 50% 10%;
      flex-direction: column;
      gap: 3px;
      box-shadow: 0 14px 28px -12px rgba(16, 16, 16, 0.55), 0 0 0 4px rgba(217, 196, 138, 0.12);
    }

    .hero__video-cta:hover,
    .hero__video-cta:focus-visible {
      box-shadow: 0 18px 34px -10px rgba(16, 16, 16, 0.65), 0 0 0 5px rgba(217, 196, 138, 0.2);
    }

    .hero__video-cta .hero__video-label {
      font-size: 9px;
    }

    @media (min-width: 1224px) {
      .hero__video-cta {
        top: 351px;
        left: 442px;
        width: 124px;
        height: 124px;
        gap: 4px;
      }

      .hero__video-cta .hero__video-label {
        font-size: 11px;
      }
    }

    .hero__video-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      color: var(--crn-bleu-nuit-profond);
      font-family: var(--font-labeur);
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-align: center;
      line-height: 1.15;
    }

    .hero__content {
      max-width: 54%;
    }

    /* Portrait bleed sur le bord droit du héros, composition asymétrique (référence maquette) ;
       jamais superposé au texte grâce à la largeur contrainte de .hero__content. */
    .hero__speaker {
      display: block;
      position: absolute;
      z-index: 2;
      top: auto;
      bottom: 0;
      right: 4%;
      height: 96%;
      width: auto;
      max-width: 44%;
      margin: 0;
      object-fit: contain;
      object-position: bottom;
      pointer-events: none;
      filter: drop-shadow(0 24px 32px rgba(16, 16, 16, 0.35));
    }

    .hero__badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: var(--tap-target-min);
      background: rgba(16, 16, 16, 0.45);
      backdrop-filter: blur(2px);
      color: var(--crn-blanc);
      font-family: var(--font-labeur);
      font-weight: 700;
      font-size: 14px;
      padding: 0 var(--space-2);
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
  }

</style>
