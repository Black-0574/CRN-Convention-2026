---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/shared/Section.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import SpeakerCard from '../../components/speakers/SpeakerCard.astro';
import Icon, { type IconName } from '../../components/shared/Icon.astro';
import { isPublished } from '../../lib/state';

export async function getStaticPaths() {
  const speakers = await getCollection('speakers');
  return speakers.map((s) => ({ params: { slug: s.id }, props: { speaker: s } }));
}

const { speaker } = Astro.props;
const now = new Date();
const publie = isPublished(now, speaker.data.datePublication);

// Biographie saisie dans l'admin (champ texte) : une ligne vide sépare deux paragraphes ; un
// texte vide ou fait d'espaces équivaut à l'absence de biographie.
const paragraphesBio = (speaker.data.bio ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Réseaux sociaux saisis dans l'admin → pictogramme au trait + nom lisible (lecteurs d'écran).
const reseaux = {
  facebook: { icone: 'facebook', libelle: 'Facebook' },
  instagram: { icone: 'instagram', libelle: 'Instagram' },
  youtube: { icone: 'youtube', libelle: 'YouTube' },
  tiktok: { icone: 'tiktok', libelle: 'TikTok' },
  linkedin: { icone: 'linkedin', libelle: 'LinkedIn' },
  x: { icone: 'x', libelle: 'X' },
  site: { icone: 'globe', libelle: 'Site web' },
} satisfies Record<string, { icone: IconName; libelle: string }>;
const liensReseaux = speaker.data.reseauxSociaux ?? [];

const categorieLabels: Record<string, string> = {
  hote: 'Hôte',
  international: 'Orateur international',
  national: 'Orateur national',
  prophetique: 'Ministère prophétique',
  plateforme: 'Intervenante de plateforme',
};
---

<BaseLayout
  title={speaker.data.nom}
  description={`Fiche orateur — ${speaker.data.nom}, Convention CRN 2026.`}
>
  <Section tone="default" ariaLabel="Fiche orateur">
    <Breadcrumb
      items={[
        { label: 'Accueil', href: '/' },
        { label: 'Orateurs', href: '/orateurs' },
        { label: speaker.data.nom },
      ]}
    />
    {publie ? (
      <div class="speaker-detail" data-reveal>
        <div class="speaker-detail__photo">
          <SpeakerCard nom={speaker.data.nom} categorie={speaker.data.categorie} photo={speaker.data.photo} hideCaption />
        </div>
        <div>
          <p class="speaker-detail__category">{categorieLabels[speaker.data.categorie]}</p>
          <h1>{speaker.data.nom}</h1>
          {speaker.data.fonction && <p class="speaker-detail__fonction">{speaker.data.fonction}</p>}
          {liensReseaux.length > 0 && (
            <ul class="speaker-detail__reseaux" aria-label={`Réseaux sociaux de ${speaker.data.nom}`}>
              {liensReseaux.map((r) => (
                <li>
                  <a
                    href={r.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${reseaux[r.reseau].libelle} de ${speaker.data.nom} (nouvel onglet)`}
                  >
                    <Icon name={reseaux[r.reseau].icone} size={20} />
                  </a>
                </li>
              ))}
            </ul>
          )}
          {paragraphesBio.length > 0 ? (
            <div class="speaker-detail__bio">
              {paragraphesBio.map((p) => <p>{p}</p>)}
            </div>
          ) : (
            <p class="speaker-detail__placeholder">Biographie à paraître.</p>
          )}
          <a class="speaker-detail__back" href="/orateurs">← Tous les orateurs</a>
        </div>
      </div>
    ) : (
      <div class="speaker-detail__hidden">
        <h1>Fiche à venir</h1>
        <p>Cette fiche sera révélée prochainement.</p>
      </div>
    )}
  </Section>
</BaseLayout>

<style>
  .speaker-detail {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  .speaker-detail__photo {
    max-width: 220px;
  }

  .speaker-detail__category {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    font-size: var(--text-s);
    color: var(--crn-or-profond);
    background: var(--crn-creme);
    border: 1px solid var(--crn-or-lumiere);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    margin-bottom: var(--space-1);
  }

  .speaker-detail__fonction {
    margin: calc(-1 * var(--space-1)) 0 var(--space-2) 0;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  /* Pastilles au trait (bleu nuit sur crème, jamais l'or sur fond clair), zone tactile 44 px. */
  .speaker-detail__reseaux {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0 0 var(--space-3) 0;
    padding: 0;
  }

  .speaker-detail__reseaux a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--crn-gris-clair);
    background: var(--crn-creme);
    color: var(--crn-bleu-nuit);
    transition: background-color var(--transition-standard), color var(--transition-standard), border-color var(--transition-standard);
  }

  .speaker-detail__reseaux a:hover,
  .speaker-detail__reseaux a:focus-visible {
    background: var(--crn-bleu-nuit);
    border-color: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
  }

  /* Retours à la ligne simples conservés à l'intérieur d'un paragraphe. */
  .speaker-detail__bio p {
    white-space: pre-line;
    max-width: 68ch;
    margin: 0 0 var(--space-2) 0;
  }

  .speaker-detail__placeholder {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .speaker-detail__back {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--crn-bleu-nuit);
    text-decoration: none;
  }

  .speaker-detail__back:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .speaker-detail {
      grid-template-columns: 220px 1fr;
      align-items: start;
    }
  }
</style>
