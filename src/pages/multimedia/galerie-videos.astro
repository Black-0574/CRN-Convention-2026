---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/shared/Section.astro';
import PageHero from '../../components/shared/PageHero.astro';
import Icon from '../../components/shared/Icon.astro';
---

<BaseLayout
  title="Galerie vidéos"
  description="Les vidéos de la Convention CRN 2026 seront publiées ici après l'évènement."
>
  <PageHero
    eyebrow="Multimédia"
    title="Galerie vidéos"
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Multimédia' }, { label: 'Galerie vidéos' }]}
  />

  <Section tone="default" ariaLabel="Galerie vidéos">
    <div class="placeholder" data-reveal>
      <span class="placeholder__icon"><Icon name="play" size={28} /></span>
      <p>
        Les vidéos de la Convention CRN 2026 (temps forts, enseignements, moments marquants) seront
        publiées sur cette page après l'évènement (6 – 13 décembre 2026).
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 60ch;
    padding: var(--space-3);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    border-top: 3px solid var(--crn-or);
    box-shadow: var(--shadow-card);
  }

  .placeholder__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--crn-creme);
    border: 1.5px solid var(--crn-or);
    color: var(--crn-bleu-nuit);
  }

  .placeholder p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
