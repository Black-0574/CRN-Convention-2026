---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/shared/Section.astro';
import PageHero from '../../components/shared/PageHero.astro';
import Icon from '../../components/shared/Icon.astro';
import imageAttente from '../../assets/images/accueil/galeries-attente.webp';
---

<BaseLayout
  title="Galerie audios"
  description="Les enregistrements audio de la Convention CRN 2026 seront publiés ici après l'évènement."
>
  <PageHero
    eyebrow="Multimédia"
    title="Galerie audios"
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Multimédia' }, { label: 'Galerie audios' }]}
  />

  <Section tone="default" ariaLabel="Galerie audios">
    <div class="placeholder" data-reveal>
      <!-- M-01 : état d’attente des galeries, image décorative. -->
      <div class="placeholder__visuel">
        <Image src={imageAttente} alt="" widths={[400, 640, 900]} sizes="(min-width: 768px) 600px, 92vw" loading="lazy" />
      </div>
      <span class="placeholder__icon"><Icon name="music" size={28} /></span>
      <p>
        Les enregistrements audio de la Convention CRN 2026 (enseignements, messages) seront publiés
        sur cette page après l'évènement (6 – 13 décembre 2026).
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .placeholder__visuel {
    align-self: stretch;
    aspect-ratio: 16 / 9;
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) 0;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    border-bottom: 2px solid var(--crn-or);
  }

  .placeholder__visuel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 60ch;
    padding: var(--space-3);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    border-top: 3px solid var(--crn-or);
    box-shadow: var(--shadow-card);
  }

  .placeholder__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--crn-creme);
    border: 1.5px solid var(--crn-or);
    color: var(--crn-bleu-nuit);
  }

  .placeholder p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
