---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/shared/Section.astro';
import Button from '../components/shared/Button.astro';
import PageHero from '../components/shared/PageHero.astro';
import InfoCard from '../components/shared/InfoCard.astro';
import CadreOr from '../components/shared/CadreOr.astro';
import { lienBoutique } from '../lib/boutique';
---

<BaseLayout
  title="Diaspora"
  description="Suivez la Convention CRN 2026 à distance, donnez en ligne, et rejoignez la session diaspora du 19 décembre."
>
  <PageHero
    eyebrow="Où que vous soyez"
    title="Diaspora"
    intro="La Convention CRN 2026 se vit aussi à distance. Le fuseau horaire de Libreville est identique à celui de Paris en décembre (UTC+1) : suivez les séances en direct, aux mêmes horaires qu’au Gabon, sans VPN et sans dépendre d’une plateforme bloquée."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Diaspora' }]}
  />

  <Section tone="default" ariaLabel="Diaspora">
    <div class="diaspora-grid" data-reveal-group>
      <CadreOr><InfoCard>
        <h2 class="diaspora-card__title">Suivre à distance</h2>
        <p>Le direct et le programme du jour seront accessibles depuis cette page pendant la Convention (6 – 13 décembre).</p>
        <Button href="/programme" variant="secondary">Voir le programme</Button>
      </InfoCard></CadreOr>
      <CadreOr><InfoCard>
        <h2 class="diaspora-card__title">Donner en ligne</h2>
        <p>Soutenez la Convention et l'action sociale par carte bancaire, depuis où que vous soyez.</p>
        <Button href={lienBoutique('diaspora')} variant="secondary">Accéder à la boutique</Button>
      </InfoCard></CadreOr>
      <CadreOr><InfoCard>
        <h2 class="diaspora-card__title">Académie à distance</h2>
        <p>Suivez l'Académie des Sciences Divines depuis la diaspora, selon les modalités confirmées avant la Convention.</p>
        <Button href="/academie" variant="secondary">Découvrir l'Académie</Button>
      </InfoCard></CadreOr>
      <CadreOr><InfoCard>
        <h2 class="diaspora-card__title">Session diaspora</h2>
        <p>Une session en ligne dédiée à la diaspora se tient le <strong>19 décembre 2026</strong>. Les modalités de connexion seront publiées sur cette page.</p>
      </InfoCard></CadreOr>
    </div>
  </Section>
</BaseLayout>

<style>
  .diaspora-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 1fr;
  }

  .diaspora-grid :global(.info-card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .diaspora-card__title {
    font-size: var(--text-h4-mobile);
    margin: 0;
  }

  @media (min-width: 768px) {
    .diaspora-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
