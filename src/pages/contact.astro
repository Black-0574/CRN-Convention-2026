---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/shared/Section.astro';
import PageHero from '../components/shared/PageHero.astro';
import imageHeros from '../assets/images/heros/contact.webp';
import imageEcoute from '../assets/images/accueil/contact-ecoute.webp';
import Icon from '../components/shared/Icon.astro';
import { hotline } from '../lib/contact';
import { reseauxSociaux } from '../lib/social';
import { API_BOUTIQUE } from '../lib/boutique-api';
import { ACCEPT, FAMILLES, LIMITES, tailleLisible } from '../../backend/src/candidatures/regles';

// Dépôt de candidature (13 novembre 2026) : limites affichées = celles que le back-office applique.
const limitesTexte = Object.values(FAMILLES)
  .map((f) => `${f.libelle.toLowerCase()} ${tailleLisible(f.max)}`)
  .join(', ');
---

<BaseLayout
  title="Contact"
  description="Contacter l’équipe de la Convention CRN 2026 : formulaire, hotline, e-mail et réseaux sociaux."
>
  <PageHero
    eyebrow="Nous écrire"
    title="Contact"
    intro="Une question sur la Convention, la billetterie ou le programme ? Écrivez-nous, l’équipe vous répond au plus vite."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]}
    image={imageHeros}
  />

  <Section tone="default" ariaLabel="Contact">
    <div class="contact-layout">
      <div class="contact-card" data-reveal>
        <h2 class="contact-card__title">Envoyez-nous un message</h2>
        <p class="contact-card__subtitle" data-objet-texte="message">
          Remplissez le formulaire ci-dessous : votre messagerie s’ouvre avec le message prérempli,
          prêt à envoyer.
        </p>
        <p class="contact-card__subtitle" data-objet-texte="candidature" hidden>
          Joignez votre CV, vos lettres, photos, audios ou vidéos : votre candidature est transmise
          directement à l’équipe des bénévoles.
        </p>

        <form class="contact-form" id="contact-form" data-api={`${API_BOUTIQUE}/api/candidatures`}>
          <div class="contact-field">
            <label for="contact-objet">Objet</label>
            <select id="contact-objet" name="objet">
              <option value="message">Question ou message</option>
              <option value="candidature">Dépôt de candidature</option>
            </select>
          </div>

          <div class="contact-field" data-candidature hidden>
            <label for="contact-poste">Titre du poste</label>
            <input type="text" id="contact-poste" name="poste" maxlength={LIMITES.poste} placeholder="Ex. Journaliste, cadreur, monteur vidéo, graphiste…" />
          </div>

          <div class="contact-form__row">
            <div class="contact-field">
              <label for="contact-prenom">Prénom</label>
              <input type="text" id="contact-prenom" name="prenom" autocomplete="given-name" required />
            </div>
            <div class="contact-field">
              <label for="contact-nom">Nom</label>
              <input type="text" id="contact-nom" name="nom" autocomplete="family-name" />
            </div>
          </div>

          <div class="contact-field">
            <label for="contact-email">E-mail</label>
            <input type="email" id="contact-email" name="email" autocomplete="email" required />
          </div>

          <div class="contact-field">
            <label for="contact-telephone">Téléphone <span class="contact-field__optional">(facultatif)</span></label>
            <input type="tel" id="contact-telephone" name="telephone" autocomplete="tel" placeholder="+241 00 00 00 00" />
          </div>

          <div class="contact-field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows={5} maxlength={LIMITES.message} required></textarea>
          </div>

          <div class="contact-field" data-candidature hidden>
            <label for="contact-pieces">Pièces jointes <span class="contact-field__optional">(facultatif)</span></label>
            <input type="file" id="contact-pieces" name="pieces" multiple accept={ACCEPT} aria-describedby="contact-pieces-aide" />
            <p class="contact-field__aide" id="contact-pieces-aide">
              Word ou PDF, images, audio ou vidéo : {LIMITES.fichiers} fichiers au plus, {tailleLisible(LIMITES.total)} au
              total ({limitesTexte} par fichier).
            </p>
            <ul class="contact-pieces" id="contact-pieces-liste"></ul>
          </div>

          <label class="contact-consentement" data-candidature hidden>
            <input type="checkbox" name="consentement" value="oui" />
            <span>J’accepte que ma candidature et mes pièces jointes soient transmises à l’équipe des bénévoles de la Convention CRN 2026 pour l’étude de ma candidature.</span>
          </label>

          <!-- Champ piège anti-robot : invisible et ignoré par les lecteurs d'écran. -->
          <div class="contact-piege" aria-hidden="true">
            <label for="contact-site-web">Site web</label>
            <input type="text" id="contact-site-web" name="site_web" tabindex="-1" autocomplete="off" />
          </div>

          <div class="contact-envoi" id="contact-envoi" hidden>
            <progress id="contact-progression" max="100" value="0"></progress>
            <span id="contact-progression-texte"></span>
          </div>
          <p class="contact-statut" id="contact-statut" role="status" aria-live="polite"></p>

          <button type="submit" class="button button--primary contact-form__submit" id="contact-envoyer">
            <span id="contact-envoyer-libelle">Envoyer le message</span> <Icon name="arrow-right" size={16} />
          </button>
        </form>
      </div>

      <aside class="contact-aside" data-reveal>
        <!-- C-02 : vignette décorative (casque d’écoute, carnet). -->
        <div class="contact-aside__visuel">
          <Image src={imageEcoute} alt="" widths={[400, 700]} sizes="(min-width: 1024px) 380px, 92vw" loading="lazy" />
        </div>
        <p class="contact-aside__title">Nous sommes à votre écoute.</p>
        <p class="contact-aside__text">
          Pour toute urgence pendant la Convention, privilégiez la hotline — réponse plus rapide
          que par e-mail.
        </p>

        <ul class="contact-aside__list">
          <li class="contact-aside__item">
            <span class="contact-aside__icon"><Icon name="phone" size={20} /></span>
            <span>
              <span class="contact-aside__label">Hotline</span>
              <a href={hotline.tel}>{hotline.affichage}</a>
            </span>
          </li>
          <li class="contact-aside__item">
            <span class="contact-aside__icon"><Icon name="whatsapp" size={20} /></span>
            <span>
              <span class="contact-aside__label">WhatsApp</span>
              <a href={hotline.whatsapp} target="_blank" rel="noopener noreferrer">{hotline.affichage}</a>
            </span>
          </li>
          <li class="contact-aside__item">
            <span class="contact-aside__icon"><Icon name="mail" size={20} /></span>
            <span>
              <span class="contact-aside__label">E-mail</span>
              <a href="mailto:contact@crn-convention2026.events">contact@crn-convention2026.events</a>
            </span>
          </li>
        </ul>

        <p class="contact-aside__social-title">Nous suivre</p>
        <ul class="contact-aside__social">
          {reseauxSociaux.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label}>
                <Icon name={r.name} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <script>
    import { verifierPieces, tailleLisible } from '../../backend/src/candidatures/regles';

    // Objet « Question ou message » : envoi via mailto, prérempli à partir des champs (L2).
    // Objet « Dépôt de candidature » (13 novembre 2026) : envoi au back-office avec les pièces
    // jointes, transmis par e-mail à benevoles@crn-convention2026.events.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const objet = document.getElementById('contact-objet') as HTMLSelectElement | null;
    const poste = document.getElementById('contact-poste') as HTMLInputElement | null;
    const pieces = document.getElementById('contact-pieces') as HTMLInputElement | null;
    const champMessage = document.getElementById('contact-message') as HTMLTextAreaElement | null;
    const liste = document.getElementById('contact-pieces-liste');
    const statut = document.getElementById('contact-statut');
    const envoi = document.getElementById('contact-envoi');
    const progression = document.getElementById('contact-progression') as HTMLProgressElement | null;
    const progressionTexte = document.getElementById('contact-progression-texte');
    const bouton = document.getElementById('contact-envoyer') as HTMLButtonElement | null;
    const libelle = document.getElementById('contact-envoyer-libelle');
    const consentement = form?.querySelector<HTMLInputElement>('input[name="consentement"]');

    const estCandidature = () => objet?.value === 'candidature';
    const afficherStatut = (texte: string, type: 'erreur' | 'succes' | '' = '') => {
      if (!statut) return;
      statut.textContent = texte;
      statut.dataset.type = type;
    };

    function appliquerObjet() {
      const c = estCandidature();
      document.querySelectorAll<HTMLElement>('[data-candidature]').forEach((el) => (el.hidden = !c));
      document.querySelectorAll<HTMLElement>('[data-objet-texte]').forEach((el) => (el.hidden = el.dataset.objetTexte !== (c ? 'candidature' : 'message')));
      if (poste) poste.required = c;
      // Informations demandées par l'appel à candidatures (13 novembre 2026).
      if (champMessage) champMessage.placeholder = c ? 'Église ou communauté CRN, ville et pays, domaine de compétence, expérience, disponibilité pendant la Convention, lien vers un portfolio…' : '';
      if (consentement) consentement.required = c;
      if (libelle) libelle.textContent = c ? 'Envoyer ma candidature' : 'Envoyer le message';
      afficherStatut('');
    }
    objet?.addEventListener('change', appliquerObjet);
    // Lien « Accéder au formulaire de candidature » (/contact?objet=candidature) : objet présélectionné.
    if (objet && new URLSearchParams(location.search).get('objet') === 'candidature') objet.value = 'candidature';
    appliquerObjet();

    // Liste des fichiers choisis, avec leur taille et les éventuels refus, avant tout envoi.
    function erreursPieces(): string[] {
      const fichiers = [...(pieces?.files ?? [])];
      if (liste) {
        liste.replaceChildren(
          ...fichiers.map((f) => {
            const li = document.createElement('li');
            li.textContent = `${f.name} — ${tailleLisible(f.size)}`;
            return li;
          }),
        );
      }
      return verifierPieces(fichiers.map((f) => ({ nom: f.name, taille: f.size })));
    }
    pieces?.addEventListener('change', () => {
      const erreurs = erreursPieces();
      afficherStatut(erreurs.join(' '), erreurs.length ? 'erreur' : '');
    });

    function envoyerCandidature(f: HTMLFormElement) {
      const erreurs = erreursPieces();
      if (erreurs.length) return afficherStatut(erreurs.join(' '), 'erreur');
      const donnees = new FormData(f);
      donnees.delete('objet');
      const xhr = new XMLHttpRequest();
      xhr.open('POST', f.dataset.api ?? '');
      xhr.timeout = 15 * 60 * 1000;
      // Progression de l'envoi : utile en 3G pour des pièces jointes de plusieurs Mo.
      xhr.upload.addEventListener('progress', (e) => {
        if (!e.lengthComputable || !progression || !progressionTexte) return;
        progression.value = Math.round((e.loaded / e.total) * 100);
        progressionTexte.textContent = `Envoi : ${progression.value}\u00a0% (${tailleLisible(e.loaded)} sur ${tailleLisible(e.total)})`;
      });
      const terminer = () => {
        if (bouton) bouton.disabled = false;
        if (envoi) envoi.hidden = true;
      };
      xhr.addEventListener('load', () => {
        terminer();
        let reponse: { erreur?: string; reference?: string } = {};
        try {
          reponse = JSON.parse(xhr.responseText);
        } catch {
          /* réponse non JSON : message générique ci-dessous */
        }
        if (xhr.status === 201) {
          f.reset();
          appliquerObjet();
          liste?.replaceChildren();
          afficherStatut(
            `Merci\u00a0! Votre candidature a bien été transmise à l’équipe des bénévoles${reponse.reference ? ` (référence ${reponse.reference})` : ''}. Elle vous répondra à l’adresse e-mail indiquée.`,
            'succes',
          );
        } else if (xhr.status === 413) {
          afficherStatut(reponse.erreur ?? 'Pièces jointes trop lourdes.', 'erreur');
        } else {
          afficherStatut(reponse.erreur ?? 'L’envoi n’a pas abouti. Réessayez dans quelques minutes ou écrivez à benevoles@crn-convention2026.events.', 'erreur');
        }
      });
      const echec = () => {
        terminer();
        afficherStatut('Connexion interrompue pendant l’envoi. Vérifiez votre réseau et réessayez, ou écrivez à benevoles@crn-convention2026.events.', 'erreur');
      };
      xhr.addEventListener('error', echec);
      xhr.addEventListener('timeout', echec);
      if (bouton) bouton.disabled = true;
      if (envoi) envoi.hidden = false;
      if (progression) progression.value = 0;
      afficherStatut('');
      xhr.send(donnees);
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (estCandidature()) return envoyerCandidature(event.currentTarget as HTMLFormElement);
      const data = new FormData(form as HTMLFormElement);
      const prenom = String(data.get('prenom') ?? '').trim();
      const nom = String(data.get('nom') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const telephone = String(data.get('telephone') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      const sujet = `Contact Convention CRN 2026 — ${prenom} ${nom}`.trim();
      const corps = [
        `Nom : ${prenom} ${nom}`.trim(),
        `E-mail : ${email}`,
        telephone && `Téléphone : ${telephone}`,
        '',
        message,
      ]
        .filter(Boolean)
        .join('\n');

      const lien = `mailto:contact@crn-convention2026.events?subject=${encodeURIComponent(sujet)}&body=${encodeURIComponent(corps)}`;
      window.location.href = lien;
    });
  </script>
</BaseLayout>

<style>
  /* minmax(0, …) : une colonne ne s'élargit jamais au-delà de l'écran pour un mot insécable
     (adresse e-mail longue sur un téléphone de 320 px). */
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: var(--space-3) 0 var(--space-6) 0;
  }

  .contact-card {
    padding: var(--space-3);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .contact-card__title {
    margin: 0 0 var(--space-1) 0;
  }

  .contact-card__subtitle {
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text-muted);
  }

  .contact-form {
    /* Arrivée par #contact-form (bouton de l'appel à candidatures) : sous l'en-tête fixe. */
    scroll-margin-top: 140px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-field label {
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: var(--text-s);
    color: var(--crn-bleu-nuit);
  }

  .contact-field__optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    font-family: var(--font-labeur);
    font-size: var(--text-s);
    min-height: var(--tap-target-min);
    padding: 10px 14px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--crn-blanc);
    color: var(--color-text);
    transition: border-color var(--transition-standard), box-shadow var(--transition-standard);
  }

  .contact-field textarea {
    min-height: 120px;
    padding-top: 10px;
    resize: vertical;
  }

  .contact-field input:focus,
  .contact-field textarea:focus {
    border-color: var(--crn-bleu-nuit);
  }

  .contact-form__submit {
    align-self: flex-start;
    margin-top: var(--space-1);
  }

  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* Dépôt de candidature (13 novembre 2026) : pièces jointes, consentement, progression. */
  .contact-field input[type='file'] {
    padding: 10px;
    background: var(--crn-creme);
    border-style: dashed;
    cursor: pointer;
  }

  .contact-field input[type='file']::file-selector-button {
    margin-right: 12px;
    padding: 8px 16px;
    font: 700 var(--text-s) var(--font-labeur);
    color: var(--crn-blanc);
    background: var(--crn-bleu-nuit);
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .contact-field__aide {
    margin: 0;
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .contact-pieces {
    margin: 0;
    padding-left: 20px;
    font-size: var(--text-s);
    overflow-wrap: anywhere;
  }

  .contact-consentement {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: var(--text-s);
  }

  .contact-consentement input {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    accent-color: var(--crn-bleu-nuit);
  }

  .contact-consentement[hidden],
  .contact-field[hidden] {
    display: none;
  }

  .contact-piege {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-envoi {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .contact-envoi[hidden] {
    display: none;
  }

  .contact-envoi progress {
    width: 100%;
    height: 10px;
    accent-color: var(--crn-or);
  }

  .contact-statut:empty {
    display: none;
  }

  .contact-statut {
    margin: 0;
    padding: 12px 16px;
    border-radius: var(--radius-control);
    font-size: var(--text-s);
    background: var(--crn-creme);
    border-left: 4px solid var(--crn-bleu-nuit);
  }

  .contact-statut[data-type='erreur'] {
    border-left-color: var(--crn-noir);
    font-weight: 700;
  }

  .contact-statut[data-type='succes'] {
    border-left-color: var(--crn-or);
    color: var(--crn-bleu-nuit);
    font-weight: 700;
  }

  /* Volet sombre (bleu nuit) : seule zone de la page en accent fort, pour faire ressortir les
     coordonnées de contact comme dans le modèle de référence. */
  .contact-aside {
    padding: var(--space-3);
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
    color: var(--crn-blanc);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
  }

  .contact-aside__visuel {
    aspect-ratio: 4 / 3;
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    border-bottom: 2px solid var(--crn-or);
  }

  .contact-aside__visuel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-aside__title {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: var(--text-h4-mobile);
    margin: 0 0 var(--space-1) 0;
  }

  .contact-aside__text {
    margin: 0 0 var(--space-3) 0;
    color: rgba(255, 255, 255, 0.78);
  }

  .contact-aside__list {
    list-style: none;
    margin: 0 0 var(--space-3) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-aside__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .contact-aside__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(184, 150, 62, 0.14);
    border: 1.5px solid var(--crn-or);
    color: var(--crn-or);
  }

  .contact-aside__item > span:last-child {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-aside__label {
    font-size: var(--text-s);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--crn-or);
  }

  .contact-aside__item a {
    color: var(--crn-blanc);
    text-decoration: none;
    font-weight: 700;
  }

  .contact-aside__item a:hover {
    color: var(--crn-or);
    text-decoration: underline;
  }

  .contact-aside__social-title {
    font-size: var(--text-s);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--crn-or);
    margin: 0 0 var(--space-1) 0;
  }

  .contact-aside__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-1);
  }

  .contact-aside__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    color: var(--crn-blanc);
    transition: background-color var(--transition-standard), border-color var(--transition-standard), color var(--transition-standard), transform var(--transition-standard);
  }

  .contact-aside__social a:hover,
  .contact-aside__social a:focus-visible {
    background: var(--crn-or);
    border-color: var(--crn-or);
    color: var(--crn-noir);
    transform: translateY(-2px);
  }

  @media (min-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
