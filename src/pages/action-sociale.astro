---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/shared/Section.astro';
import PageHero from '../components/shared/PageHero.astro';
import imageHeros from '../assets/images/heros/action-sociale.webp';
import InfoCard from '../components/shared/InfoCard.astro';
import CadreOr from '../components/shared/CadreOr.astro';
---

<BaseLayout
  title="Action sociale"
  description="Distribution de kits alimentaires aux familles en difficulté le 5 décembre 2026, après une collecte de denrées, produits d’hygiène et vêtements du 10 au 27 novembre dans toutes les Églises CRN."
>
  <PageHero
    eyebrow="De l’autel à la cité"
    title="Action sociale"
    intro="À l’image du thème « de l’autel à la cité », la Convention CRN 2026 porte un geste concret vers les familles de Libreville : une collecte de vivres et de vêtements, suivie d’une distribution lors de la pré-convention sociale."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Action sociale' }]}
    image={imageHeros}
  />

  <Section tone="default" ariaLabel="Détails de la collecte">
    <div class="info-grid" data-reveal-group>
      <CadreOr><InfoCard>
        <p class="info-card__label">Collecte</p>
        <p class="info-card__value">Du 10 au 27 novembre 2026, dans toutes les Églises CRN</p>
      </InfoCard></CadreOr>
      <CadreOr><InfoCard>
        <p class="info-card__label">Distribution</p>
        <p class="info-card__value">Samedi 5 décembre 2026, 9h – 12h, Église Centrale</p>
      </InfoCard></CadreOr>
    </div>

    <!-- Texte du Commanditaire (23 novembre 2026) ; vêtements ajoutés à la liste à sa demande. -->
    <div class="appel">
      <h2>Distribution de kits alimentaires aux familles en difficulté</h2>
      <p>
        Sous la supervision de la Responsable épiscopale de l’Évangélisation, des Actions sociales et
        de l’Engagement sociétal, l’Évêque Nadia Jocktane, le Ministère Christ Révélé aux Nations
        organise la distribution des kits alimentaires aux familles en difficulté le samedi
        5&nbsp;décembre 2026 à l’Église Centrale.
      </p>

      <h2>Collecte de denrées alimentaires</h2>
      <p>
        Pour mener à bien cette action, une grande collecte de denrées alimentaires débute dès le mardi
        10&nbsp;novembre 2026 dans l’ensemble de nos Églises.
      </p>

      <h3>Nous avons besoin de&nbsp;:</h3>
      <ul>
        <li>riz, pâtes&nbsp;;</li>
        <li>huile, sucre&nbsp;;</li>
        <li>boîtes de conserve (sardines, maquereau, cassoulet)&nbsp;;</li>
        <li>lait en poudre&nbsp;;</li>
        <li>savon et produits d’hygiène&nbsp;;</li>
        <li>vêtements.</li>
      </ul>
      <p>Les dons financiers sont également les bienvenus.</p>

      <p>
        Chaque sac de riz, chaque litre d’huile, chaque boîte de conserve compte. Ensemble, apportons
        espoir et dignité à nos frères et sœurs.
      </p>
      <p>Nous comptons sur la mobilisation de chacun pour la réussite de ce moment de charité.</p>
      <p class="appel__benediction">Que Dieu vous bénisse.</p>
    </div>

    <p class="info-footnote">
      Pour soutenir cette action depuis la diaspora, consultez la page <a href="/diaspora">Diaspora</a>.
    </p>
  </Section>
</BaseLayout>

<style>
  .info-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 1fr;
  }

  .info-card__label {
    font-family: var(--font-labeur);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--text-s);
    letter-spacing: 0.06em;
    color: var(--crn-bleu-nuit);
    margin: 0 0 6px 0;
  }

  .info-card__value {
    margin: 0;
    font-size: var(--text-h4-mobile);
    font-family: var(--font-titrage);
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  .info-footnote {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .appel {
    max-width: 72ch;
    margin-top: var(--space-6);
  }

  .appel h2 {
    font-family: var(--font-titrage);
    color: var(--crn-bleu-nuit);
    margin: var(--space-3) 0 var(--space-1);
  }

  .appel h2:first-child {
    margin-top: 0;
  }

  .appel h3 {
    color: var(--crn-bleu-nuit);
    margin: var(--space-2) 0 var(--space-1);
  }

  .appel ul {
    margin: 0 0 var(--space-2);
    padding-left: 1.25em;
  }

  .appel__benediction {
    font-family: var(--font-titrage);
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  @media (min-width: 768px) {
    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
