---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/shared/Section.astro';
import PageHero from '../components/shared/PageHero.astro';
import FaqAccordion from '../components/shared/FaqAccordion.astro';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout
  title="Questions fréquentes"
  description="Questions fréquentes sur la Convention CRN 2026 : accès, QR code, pass, horaires, paiement, accès sans VPN."
>
  <PageHero
    eyebrow="Vos questions, nos réponses"
    title="Questions fréquentes"
    intro="Accès, QR code, pass, horaires, paiement : les réponses aux questions les plus fréquentes sur la Convention CRN 2026."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'FAQ' }]}
  />

  <Section tone="default" ariaLabel="Questions fréquentes">
    <FaqAccordion items={faqs.map((f) => f.data)} />
  </Section>
</BaseLayout>
