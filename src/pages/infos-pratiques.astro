---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/shared/Section.astro';
import PageHero from '../components/shared/PageHero.astro';
import imageHeros from '../assets/images/heros/infos-pratiques.webp';
import InfoCard from '../components/shared/InfoCard.astro';
import CadreOr from '../components/shared/CadreOr.astro';

const lieux = [
  {
    nom: 'Église Centrale CRN',
    adresse: 'Libreville, Gabon',
    note: 'Lieu principal du 5 au 12 décembre.',
  },
  {
    // Le Nomad n'accueille plus le 13 décembre (communiqué du 11 novembre 2026).
    nom: 'Lieu à déterminer',
    adresse: 'À annoncer',
    note: 'Dimanche 13 décembre : culte unique, ordination, Concert pour la vie. Le nouveau lieu sera annoncé prochainement.',
  },
];
---

<BaseLayout
  title="Infos pratiques"
  description="Lieux, accès, horaires et règles d'accès de la Convention CRN 2026 à Libreville."
>
  <PageHero
    eyebrow="Préparez votre venue"
    title="Infos pratiques"
    intro="Lieux, accès et règles à connaître avant de rejoindre la Convention CRN 2026 à Libreville."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Infos pratiques' }]}
    image={imageHeros}
  />

  <Section tone="default" ariaLabel="Infos pratiques">
    <h2>Lieux</h2>
    <div class="venues-grid" data-reveal-group>
      {lieux.map((lieu) => (
        <CadreOr><InfoCard>
          <h3 class="venue-card__name">{lieu.nom}</h3>
          <p class="venue-card__address">{lieu.adresse}</p>
          <p class="venue-card__note">{lieu.note}</p>
        </InfoCard></CadreOr>
      ))}
    </div>

    <h2>Accès</h2>
    <p>
      Présentez votre pass ou votre ticket, avec son QR code, à chaque entrée. Les plans d'accès
      détaillés seront publiés sur cette page avant l'ouverture de la Convention.
    </p>

    <h2>Horaires</h2>
    <p>
      Consultez le <a href="/programme">programme complet</a> pour les horaires précis de chaque
      séance, jour par jour.
    </p>

    <h2>Règles d'accès</h2>
    <ul class="rules-list">
      <li>Ticket ou pass nominatif et intransférable.</li>
      <li>QR code unique, scanné à chaque entrée.</li>
      <li>Aucun accès verbal.</li>
    </ul>
  </Section>
</BaseLayout>

<style>
  .venues-grid {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-6) 0;
    grid-template-columns: 1fr;
  }

  .venue-card__name {
    font-size: var(--text-h4-mobile);
    margin-bottom: 4px;
  }

  .venue-card__address {
    margin: 0;
  }

  .venue-card__note {
    color: var(--color-text-muted);
    font-size: var(--text-s);
    margin-top: 4px;
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-3);
  }

  .rules-list li {
    position: relative;
  }

  @media (min-width: 768px) {
    .venues-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
