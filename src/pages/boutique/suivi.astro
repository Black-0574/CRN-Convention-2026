---
/*
  Suivi d'une commande (lien personnel envoyé par e-mail : /boutique/suivi?commande=…&t=…).
  Page statique : la commande est lue dans le navigateur auprès de l'API de la boutique. C'est aussi
  la page où l'agrégateur de paiement renvoie le client. Billets nominatifs (QR code) à télécharger
  une fois le paiement confirmé, livraison des articles, état de la réservation ; mise à jour
  automatique tant que le paiement est en attente.
*/
import Boutique from '../../layouts/BoutiqueLayout.astro';
---

<Boutique title="Suivi de commande">
  <div class="container suivi" data-suivi>
    <p class="suivi__numero" data-numero></p>
    <h1 data-titre>Chargement de votre commande…</h1>
    <p class="suivi__texte" data-texte></p>
    <div data-contenu></div>
    <p><a class="button button--secondary" href="/boutique">Retour à la boutique</a></p>
  </div>
</Boutique>

<script>
  import { API_BOUTIQUE } from '../../lib/boutique-adresse';
  import { formaterXAF } from '../../lib/boutique-format';
  import { vider } from '../../lib/boutique-panier';

  type Ligne = { libelle: string; quantite: number; prixUnitaireXAF: number; inclus: boolean; aLivrer: boolean };
  type Commande = {
    numero: string;
    statut: string;
    totalXAF: number;
    lignes: Ligne[];
    billets: { numero: string; titulaire: string; lien: string }[];
    livraison: { mode: string; destination: string | null; fraisXAF: number; texte: string } | null;
    paiement: { moyen: string | null; detail: string | null };
    courrielsLocaux?: string[];
  };

  const LIBELLES: Record<string, { titre: string; texte: string }> = {
    en_attente: { titre: 'Paiement en attente', texte: 'Terminez le paiement sur la page de notre partenaire de paiement. Cette page se met à jour toute seule.' },
    payee: { titre: 'Merci, votre commande est confirmée', texte: 'Vos billets sont prêts. Ils vous ont aussi été envoyés par e-mail.' },
    echouee: { titre: 'Paiement non abouti', texte: 'Le paiement a été refusé ou annulé. Aucun montant n’a été débité ; vos places ont été rendues à la vente.' },
    expiree: { titre: 'Délai de réservation dépassé', texte: 'La réservation de 15 minutes a expiré avant le paiement : vos places ont été rendues à la vente.' },
    a_verifier: { titre: 'Paiement en cours de vérification', texte: 'Votre paiement est arrivé après la fin de la réservation. L’équipe de la boutique vérifie votre commande et vous recontacte.' },
    remboursee: { titre: 'Commande remboursée', texte: 'Cette commande a été remboursée ; ses billets ne sont plus valables.' },
  };

  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const echapper = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const parametres = new URLSearchParams(location.search);
  const numero = parametres.get('commande') ?? '';
  const jeton = parametres.get('t') ?? '';
  const adresse = `${API_BOUTIQUE}/api/boutique/commandes/${encodeURIComponent(numero)}?t=${encodeURIComponent(jeton)}`;

  async function lire(): Promise<Commande | null> {
    try {
      const res = await fetch(adresse);
      return res.ok ? ((await res.json()) as Commande) : null;
    } catch {
      return null;
    }
  }

  function afficher(c: Commande) {
    const etat = LIBELLES[c.statut] ?? LIBELLES.en_attente!;
    document.title = `Commande ${c.numero} · Boutique · Convention CRN 2026`;
    $('[data-numero]').textContent = `Commande ${c.numero}`;
    $('[data-titre]').textContent = etat.titre;
    $('[data-texte]').textContent = etat.texte;

    const blocs: string[] = [];
    if (c.billets.length > 0) {
      blocs.push(`<section class="bloc"><h2>Vos billets</h2><ul class="billets">${c.billets
        .map((b) => `<li><div><strong>${echapper(b.titulaire)}</strong><span>Billet ${echapper(b.numero)}</span></div><a class="button button--primary" href="${echapper(b.lien)}" target="_blank" rel="noopener">Télécharger (PDF)</a></li>`)
        .join('')}</ul><p class="aide">Billet nominatif et non transférable : présentez-le (imprimé ou sur téléphone) avec une pièce d’identité. Le QR code est scanné à chaque entrée.</p></section>`);
    }
    const aLivrer = c.lignes.filter((l) => l.aLivrer);
    if (aLivrer.length > 0 && c.livraison) {
      blocs.push(`<section class="bloc"><h2>Livraison de vos articles</h2><ul>${aLivrer.map((l) => `<li>${echapper(l.libelle)} × ${l.quantite}</li>`).join('')}</ul><p>${echapper(c.livraison.texte)}</p></section>`);
    }
    blocs.push(`<section class="bloc"><h2>Détail</h2><ul class="detail">${c.lignes
      .map((l) => `<li><span>${l.quantite} × ${echapper(l.libelle)}</span><span>${l.inclus ? 'inclus' : formaterXAF(l.quantite * l.prixUnitaireXAF)}</span></li>`)
      .join('')}${c.livraison ? `<li><span>Livraison</span><span>${c.livraison.fraisXAF ? formaterXAF(c.livraison.fraisXAF) : 'offerte'}</span></li>` : ''}</ul><p class="detail__total"><span>Total</span><strong>${formaterXAF(c.totalXAF)}</strong></p>${
        c.statut === 'payee' && c.paiement.detail ? `<p class="aide">Payé par ${c.paiement.moyen === 'carte' ? 'carte bancaire' : 'Mobile Money'} : ${echapper(c.paiement.detail)}</p>` : ''
      }</section>`);
    if (c.courrielsLocaux?.length) {
      blocs.push(`<section class="bloc bloc--demo"><h2>E-mails envoyés (démonstration locale)</h2><ul>${c.courrielsLocaux
        .map((f) => `<li><a href="${API_BOUTIQUE}/api/boutique/dev/courriels/${encodeURIComponent(f)}" target="_blank">${echapper(f.split('--')[1] ?? f)}</a></li>`)
        .join('')}</ul></section>`);
    }
    $('[data-contenu]').innerHTML = blocs.join('');
    // Commande payée : le panier a rempli son office.
    if (c.statut === 'payee') vider();
  }

  (async () => {
    const c = await lire();
    if (!c) {
      $('[data-titre]').textContent = 'Commande introuvable';
      $('[data-texte]').textContent = 'Ce lien de suivi est incomplet ou n’est plus valable. Utilisez le lien reçu par e-mail, ou contactez la hotline.';
    } else {
      afficher(c);
      if (c.statut === 'en_attente') {
        const id = setInterval(async () => {
          const maj = await lire();
          if (maj && maj.statut !== 'en_attente') {
            clearInterval(id);
            afficher(maj);
          }
        }, 3000);
      }
    }
  })();
</script>

<style is:global>
  .suivi {
    padding-top: var(--space-6);
    max-width: 820px;
  }

  .suivi__numero {
    margin: 0;
    font-weight: 700;
    color: var(--crn-or-profond);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .suivi h1 {
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h2-mobile);
    margin: 8px 0;
  }

  .suivi__texte {
    font-size: var(--text-p);
  }

  .bloc {
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    margin: var(--space-3) 0;
  }

  .bloc h2 {
    margin-top: 0;
    font-size: var(--text-h4);
    color: var(--crn-bleu-nuit);
  }

  .bloc--demo {
    border-style: dashed;
    border-color: var(--crn-or);
    background: var(--crn-creme);
  }

  .billets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: grid;
    gap: 12px;
  }

  .billets li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-left: 3px solid var(--crn-or);
    background: var(--crn-creme);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
  }

  .billets li div {
    display: grid;
  }

  .billets li span {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .aide {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .detail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .detail li,
  .detail__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .detail__total {
    border-top: 1px solid var(--crn-gris-clair);
    padding-top: 12px;
    margin-bottom: 0;
    font-size: 20px;
  }
</style>
