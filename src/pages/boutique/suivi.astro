---
/*
  Suivi d'une commande (lien personnel envoyé par e-mail : /boutique/suivi?commande=…&t=…).
  Page statique : la commande est lue dans le navigateur auprès de l'API de la boutique. C'est aussi
  la page où l'agrégateur de paiement renvoie le client. Billets nominatifs (QR code) à télécharger
  une fois le paiement confirmé, livraison des articles, état de la réservation ; mise à jour
  automatique tant que le paiement est en attente. Paiement en espèces (16 novembre 2026) : caisse,
  horaires, échéance et numéro à donner au caissier ; billets aussi envoyables par WhatsApp une
  fois payés. Commande payée : illustration de confirmation
  (BQ-09, billet doré dans une enveloppe), décorative.
*/
import { Image } from 'astro:assets';
import Boutique from '../../layouts/BoutiqueLayout.astro';
import illustrationMerci from '../../assets/images/boutique-habillage/confirmation.webp';
---

<Boutique title="Suivi de commande">
  <div class="container suivi" data-suivi>
    <Image class="suivi__merci" src={illustrationMerci} alt="" widths={[200, 400]} sizes="200px" loading="lazy" data-illustration-merci hidden />
    <p class="suivi__numero" data-numero></p>
    <h1 data-titre>Chargement de votre commande…</h1>
    <p class="suivi__texte" data-texte></p>
    <div data-contenu></div>
    <p><a class="button button--secondary" href="/boutique">Retour à la boutique</a></p>
  </div>
</Boutique>

<script>
  import { API_BOUTIQUE } from '../../lib/boutique-adresse';
  import { formaterXAF } from '../../lib/boutique-format';
  import { vider } from '../../lib/boutique-panier';

  type Ligne = { libelle: string; quantite: number; prixUnitaireXAF: number; inclus: boolean; aLivrer: boolean };
  type Commande = {
    numero: string;
    statut: string;
    totalXAF: number;
    lignes: Ligne[];
    billets: { numero: string; titulaire: string; lien: string }[];
    livraison: { mode: string; destination: string | null; fraisXAF: number; texte: string } | null;
    paiement: { moyen: string | null; detail: string | null };
    especes: { lieu: string; horaires: string | null; echeance: string | null } | null;
    codeMarchand: { operateur: string; nom: string; ussd: string; codeCommercant: string; etapes: string[]; echeance: string | null; preuveRecue: boolean; idTransaction: string | null } | null;
    alternativeCodeMarchand: { id: string; nom: string }[] | null;
    canalBillets: 'email' | 'whatsapp' | 'email_whatsapp';
    whatsapp: string | null;
    courrielsLocaux?: string[];
  };

  const LIBELLES: Record<string, { titre: string; texte: string }> = {
    en_attente: { titre: 'Paiement en attente', texte: 'Terminez le paiement sur la page de notre partenaire de paiement. Cette page se met à jour toute seule.' },
    payee: { titre: 'Merci, votre commande est confirmée', texte: 'Vos billets sont prêts. Ils vous ont aussi été envoyés par e-mail.' },
    echouee: { titre: 'Paiement non abouti', texte: 'Le paiement a été refusé ou annulé. Aucun montant n’a été débité ; vos places ont été rendues à la vente.' },
    expiree: { titre: 'Délai de réservation dépassé', texte: 'La réservation de 15 minutes a expiré avant le paiement : vos places ont été rendues à la vente.' },
    a_verifier: { titre: 'Paiement en cours de vérification', texte: 'Votre paiement est arrivé après la fin de la réservation. L’équipe de la boutique vérifie votre commande et vous recontacte.' },
    remboursee: { titre: 'Commande remboursée', texte: 'Cette commande a été remboursée ; ses billets ne sont plus valables.' },
  };

  const ESPECES_EXPIREE = { titre: 'Délai de paiement dépassé', texte: 'La commande n’a pas été réglée à la caisse dans le délai prévu : elle est annulée et ses places ont été rendues à la vente. Vous pouvez la refaire sur la boutique.' };
  const jourHeure = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Libreville' });

  /** Titre et texte de l'état, selon le moyen de paiement et le mode d'envoi des billets. */
  function etatDe(c: Commande) {
    if (c.especes && c.statut === 'en_attente') {
      return { titre: 'À régler en espèces', texte: 'Votre commande est réservée. Présentez-vous à la caisse avec le numéro de commande ci-dessus : vos billets partent dès l’encaissement.' };
    }
    if (c.especes && c.statut === 'expiree') return ESPECES_EXPIREE;
    if (c.codeMarchand && c.statut === 'en_attente') {
      return c.codeMarchand.preuveRecue
        ? { titre: 'Paiement en cours de vérification', texte: 'Merci, votre preuve de paiement est arrivée. La boutique vérifie la réception du paiement : vos billets partent dès la validation.' }
        : { titre: `À régler par ${c.codeMarchand.nom}`, texte: 'Votre commande est réservée. Payez depuis votre téléphone en suivant les étapes ci-dessous, puis envoyez votre preuve de paiement.' };
    }
    if (c.codeMarchand && c.statut === 'expiree') return ESPECES_EXPIREE;
    if (c.statut === 'payee' && c.billets.length) {
      const envoi = c.canalBillets === 'whatsapp' ? '' : ' Ils vous ont aussi été envoyés par e-mail.';
      return { titre: LIBELLES.payee!.titre, texte: `Vos billets sont prêts.${envoi}` };
    }
    return LIBELLES[c.statut] ?? LIBELLES.en_attente!;
  }

  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const echapper = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const parametres = new URLSearchParams(location.search);
  const numero = parametres.get('commande') ?? '';
  const jeton = parametres.get('t') ?? '';
  const adresse = `${API_BOUTIQUE}/api/boutique/commandes/${encodeURIComponent(numero)}?t=${encodeURIComponent(jeton)}`;

  async function lire(): Promise<Commande | null> {
    try {
      const res = await fetch(adresse);
      return res.ok ? ((await res.json()) as Commande) : null;
    } catch {
      return null;
    }
  }

  function afficher(c: Commande) {
    const etat = etatDe(c);
    document.title = `Commande ${c.numero} · Boutique · Convention CRN 2026`;
    $('[data-numero]').textContent = `Commande ${c.numero}`;
    $('[data-titre]').textContent = etat.titre;
    $('[data-illustration-merci]').hidden = c.statut !== 'payee';
    $('[data-texte]').textContent = etat.texte;

    const blocs: string[] = [];
    if (c.especes && c.statut === 'en_attente') {
      blocs.push(`<section class="bloc bloc--especes"><h2>Paiement en espèces</h2><p class="especes__montant">${formaterXAF(c.totalXAF)}</p><dl class="especes"><dt>Caisse</dt><dd>${echapper(c.especes.lieu)}</dd><dt>Horaires</dt><dd>${echapper(c.especes.horaires ?? 'À annoncer')}</dd>${
        c.especes.echeance ? `<dt>À régler avant le</dt><dd>${jourHeure.format(new Date(c.especes.echeance))}</dd>` : ''
      }<dt>Numéro à donner</dt><dd><strong>${echapper(c.numero)}</strong></dd></dl><p class="aide">Seul le montant exact est encaissé. Passé ce délai, la commande est annulée et les places sont rendues à la vente.</p></section>`);
    }
    // Mobile Money par code marchand (28 novembre 2026) : procédure, puis preuve de paiement.
    if (c.codeMarchand && c.statut === 'en_attente') {
      const cm = c.codeMarchand;
      blocs.push(`<section class="bloc bloc--especes"><h2>Paiement ${echapper(cm.nom)}</h2><p class="especes__montant">${formaterXAF(c.totalXAF)}</p><ol class="etapes-ussd">${cm.etapes
        .map((e) => `<li>${echapper(e).replace(/( : |: )(.+)$/, (_, sep, valeur) => `${sep}<strong class="valeur-ussd">${valeur}</strong>`)}</li>`)
        .join('')}</ol>${cm.echeance && !cm.preuveRecue ? `<p class="aide">À régler avant le ${jourHeure.format(new Date(cm.echeance))} : passé ce délai, la commande est annulée et les places sont rendues à la vente.</p>` : ''}</section>`);
      blocs.push(`<section class="bloc"><h2>${cm.preuveRecue ? 'Preuve de paiement envoyée' : 'Envoyer ma preuve de paiement'}</h2>${
        cm.preuveRecue
          ? `<p>Reçue${cm.idTransaction ? ` (transaction <strong>${echapper(cm.idTransaction)}</strong>)` : ''}. En cas d’erreur, vous pouvez en envoyer une autre.</p>`
          : '<p>Après le paiement, vous recevez un SMS de confirmation : envoyez-en la capture et l’identifiant de transaction qu’il indique.</p>'
      }<form class="preuve" data-preuve novalidate><label>Capture du SMS de confirmation<input type="file" name="capture" accept="image/*" required /></label><label>Identifiant de transaction<input type="text" name="idTransaction" autocomplete="off" required /></label><p class="message-erreur" data-preuve-erreur role="alert" hidden></p><button type="submit" class="button button--primary">Envoyer ma preuve</button></form></section>`);
    }
    // Paiement en ligne en attente : alternative par code marchand, si le paiement ne passe pas.
    if (c.alternativeCodeMarchand?.length) {
      blocs.push(`<section class="bloc"><h2>Le paiement en ligne ne passe pas ?</h2><p>Payez depuis votre téléphone avec le code marchand de votre opérateur, puis envoyez la capture du SMS de confirmation. Vos places restent réservées 48&nbsp;heures.</p><div class="alternatives">${c.alternativeCodeMarchand
        .map((o) => `<button type="button" class="button button--secondary" data-code-marchand="${echapper(o.id)}">Payer par ${echapper(o.nom)}</button>`)
        .join('')}</div><p class="message-erreur" data-alternative-erreur role="alert" hidden></p></section>`);
    }
    if (c.billets.length > 0) {
      blocs.push(`<section class="bloc"><h2>Vos billets</h2><ul class="billets">${c.billets
        .map((b) => `<li><div><strong>${echapper(b.titulaire)}</strong><span>Billet ${echapper(b.numero)}</span></div><a class="button button--primary" href="${echapper(b.lien)}" target="_blank" rel="noopener">Télécharger (PDF)</a></li>`)
        .join('')}</ul>${
        c.whatsapp ? `<p><a class="button button--secondary" href="${echapper(c.whatsapp)}" target="_blank" rel="noopener noreferrer">Recevoir mes billets sur WhatsApp</a></p>` : ''
      }<p class="aide">Billet nominatif et non transférable : présentez-le (imprimé ou sur téléphone) avec une pièce d’identité. Le QR code est scanné à chaque entrée.</p></section>`);
    }
    const aLivrer = c.lignes.filter((l) => l.aLivrer);
    if (aLivrer.length > 0 && c.livraison) {
      blocs.push(`<section class="bloc"><h2>Livraison de vos articles</h2><ul>${aLivrer.map((l) => `<li>${echapper(l.libelle)} × ${l.quantite}</li>`).join('')}</ul><p>${echapper(c.livraison.texte)}</p></section>`);
    }
    blocs.push(`<section class="bloc"><h2>Détail</h2><ul class="detail">${c.lignes
      .map((l) => `<li><span>${l.quantite} × ${echapper(l.libelle)}</span><span>${l.inclus ? 'inclus' : formaterXAF(l.quantite * l.prixUnitaireXAF)}</span></li>`)
      .join('')}${c.livraison ? `<li><span>Livraison</span><span>${c.livraison.fraisXAF ? formaterXAF(c.livraison.fraisXAF) : 'offerte'}</span></li>` : ''}</ul><p class="detail__total"><span>Total</span><strong>${formaterXAF(c.totalXAF)}</strong></p>${
        c.statut === 'payee' && c.paiement.detail
          ? `<p class="aide">${
              c.paiement.moyen === 'especes'
                ? `Payé en espèces : ${echapper(c.paiement.detail.replace(/^Espèces — /, ''))}`
                : c.paiement.moyen === 'code_marchand'
                  ? `Payé par code marchand : ${echapper(c.paiement.detail)}`
                  : `Payé par ${c.paiement.moyen === 'carte' ? 'carte bancaire' : 'Mobile Money'} : ${echapper(c.paiement.detail)}`
            }</p>`
          : ''
      }</section>`);
    if (c.courrielsLocaux?.length) {
      blocs.push(`<section class="bloc bloc--demo"><h2>E-mails envoyés (démonstration locale)</h2><ul>${c.courrielsLocaux
        .map((f) => `<li><a href="${API_BOUTIQUE}/api/boutique/dev/courriels/${encodeURIComponent(f)}" target="_blank">${echapper(f.split('--')[1] ?? f)}</a></li>`)
        .join('')}</ul></section>`);
    }
    $('[data-contenu]').innerHTML = blocs.join('');
    // Commande payée : le panier a rempli son office.
    if (c.statut === 'payee') vider();
  }

  const actionBoutique = (chemin: string) => `${API_BOUTIQUE}/api/boutique/commandes/${encodeURIComponent(numero)}/${chemin}?t=${encodeURIComponent(jeton)}`;

  /** Capture réduite dans le navigateur (JPEG, 1 600 px au plus) : envoi léger en 3G ; sinon le fichier tel quel. */
  async function reduire(fichier: File): Promise<Blob> {
    try {
      const image = await createImageBitmap(fichier);
      const echelle = Math.min(1, 1600 / Math.max(image.width, image.height));
      const toile = document.createElement('canvas');
      toile.width = Math.round(image.width * echelle);
      toile.height = Math.round(image.height * echelle);
      toile.getContext('2d')!.drawImage(image, 0, 0, toile.width, toile.height);
      return await new Promise<Blob>((ok, ko) => toile.toBlob((b) => (b ? ok(b) : ko(new Error('conversion'))), 'image/jpeg', 0.82));
    } catch {
      return fichier;
    }
  }

  // Code marchand (28 novembre 2026) : choix depuis le suivi, puis envoi de la preuve.
  $('[data-contenu]').addEventListener('click', async (e) => {
    const bouton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-code-marchand]');
    if (!bouton) return;
    const erreur = $('[data-alternative-erreur]');
    bouton.disabled = true;
    try {
      const res = await fetch(actionBoutique('code-marchand'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ operateur: bouton.dataset.codeMarchand }) });
      const d = await res.json();
      if (!res.ok) throw new Error(d.erreur ?? 'Paiement par code marchand impossible.');
      const maj = await lire();
      if (maj) afficher(maj);
    } catch (err) {
      erreur.textContent = (err as Error).message;
      erreur.hidden = false;
      bouton.disabled = false;
    }
  });

  $('[data-contenu]').addEventListener('submit', async (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-preuve]');
    if (!form) return;
    e.preventDefault();
    const erreur = form.querySelector<HTMLElement>('[data-preuve-erreur]')!;
    const fichier = form.querySelector<HTMLInputElement>('[name="capture"]')!.files?.[0];
    const idTransaction = form.querySelector<HTMLInputElement>('[name="idTransaction"]')!.value.trim();
    const montrer = (m: string) => {
      erreur.textContent = m;
      erreur.hidden = false;
    };
    if (!fichier) return montrer('Joignez la capture du SMS de confirmation.');
    if (idTransaction.length < 4) return montrer('Indiquez l’identifiant de transaction reçu par SMS.');
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    bouton.disabled = true;
    bouton.textContent = 'Envoi en cours…';
    try {
      const donnees = new FormData();
      donnees.append('capture', await reduire(fichier), 'capture.jpg');
      donnees.append('idTransaction', idTransaction);
      const res = await fetch(actionBoutique('preuve'), { method: 'POST', body: donnees });
      const d = await res.json();
      if (!res.ok) throw new Error(d.erreur ?? 'Envoi impossible, réessayez.');
      const maj = await lire();
      if (maj) afficher(maj);
    } catch (err) {
      montrer((err as Error).message);
      bouton.disabled = false;
      bouton.textContent = 'Envoyer ma preuve';
    }
  });

  (async () => {
    const c = await lire();
    if (!c) {
      $('[data-titre]').textContent = 'Commande introuvable';
      $('[data-texte]').textContent = 'Ce lien de suivi est incomplet ou n’est plus valable. Utilisez le lien reçu par e-mail, ou contactez la hotline.';
    } else {
      afficher(c);
      if (c.statut === 'en_attente') {
        const id = setInterval(async () => {
          const maj = await lire();
          if (maj && maj.statut !== 'en_attente') {
            clearInterval(id);
            afficher(maj);
          }
        }, c.especes || c.codeMarchand || c.alternativeCodeMarchand ? 15_000 : 3000);
      }
    }
  })();
</script>

<style is:global>
  .suivi {
    padding-top: var(--space-6);
    max-width: 820px;
  }

  .suivi__merci {
    display: block;
    width: 200px;
    height: auto;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-card);
  }

  .suivi__merci[hidden] {
    display: none;
  }

  .suivi__numero {
    margin: 0;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .suivi h1 {
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h2-mobile);
    margin: 8px 0;
  }

  .suivi__texte {
    font-size: var(--text-p);
  }

  .bloc {
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    margin: var(--space-3) 0;
  }

  .bloc h2 {
    margin-top: 0;
    font-size: var(--text-h4);
    color: var(--crn-bleu-nuit);
  }

  .especes__montant {
    margin: 0 0 var(--space-2);
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: var(--text-h2-mobile);
    color: var(--crn-bleu-nuit);
  }

  .especes {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0 0 var(--space-2);
  }

  .especes dt {
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  .especes dd {
    margin: 0;
  }

  /* Code marchand : étapes USSD et envoi de la preuve. */
  .etapes-ussd {
    margin: 0 0 var(--space-2);
    padding-left: 24px;
    display: grid;
    gap: 6px;
    font-size: var(--text-p);
  }

  .preuve {
    display: grid;
    gap: var(--space-2);
  }

  .preuve label {
    display: grid;
    gap: 6px;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  .preuve input[type='text'],
  .preuve input[type='file'] {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    min-height: var(--tap-target-min);
    padding: 8px 12px;
    border: 1.5px solid var(--crn-gris-clair);
    border-radius: var(--radius-control);
    background: var(--crn-blanc);
    font: inherit;
    font-weight: 400;
    color: var(--crn-noir);
  }

  .preuve label {
    min-width: 0;
  }

  /* Valeur à saisir au téléphone (code, montant, référence) : jamais coupée. */
  .valeur-ussd {
    white-space: nowrap;
    color: var(--crn-bleu-nuit);
  }

  .alternatives {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .message-erreur {
    color: var(--crn-bleu-nuit);
    font-weight: 700;
    border-left: 3px solid var(--crn-or);
    padding-left: 12px;
  }

  .bloc--demo {
    border-style: dashed;
    border-color: var(--crn-or);
    background: var(--crn-creme);
  }

  .billets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: grid;
    gap: 12px;
  }

  .billets li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-left: 3px solid var(--crn-or);
    background: var(--crn-creme);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
  }

  .billets li div {
    display: grid;
  }

  .billets li span {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .aide {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .detail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .detail li,
  .detail__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .detail__total {
    border-top: 1px solid var(--crn-gris-clair);
    padding-top: 12px;
    margin-bottom: 0;
    font-size: 20px;
  }
</style>
