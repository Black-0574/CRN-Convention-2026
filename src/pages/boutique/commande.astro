---
/*
  Tunnel de commande en 3 étapes, sans rechargement de page (F01) :
  1. Vos coordonnées (compte express : aucune création de mot de passe) ;
  2. Titulaires (un par billet, F02 : chaque pass et ticket est nominatif, avec son QR code émis à
     l'achat) et livraison des articles (église du réseau au Gabon ou hors du Gabon, domicile ou
     lieu de travail à Libreville, ou retrait à la Convention) ; consentement facultatif non
     pré-coché ;
  3. Paiement sur la page sécurisée de l'agrégateur : Mobile Money (plusieurs pays) ou carte.
  La commande est créée au passage à l'étape 3 : stock et places sont alors réservés 15 minutes
  (F03), prix garanti pendant ce délai.
*/
import Boutique from '../../layouts/BoutiqueLayout.astro';
import { reglages as lireReglages } from '../../lib/boutique-api';

const r = await lireReglages();
---

<Boutique title="Commande" demo={r?.demo ?? false}>
  <div class="container tunnel">
    <h1>Votre commande</h1>
    <ol class="etapes" aria-label="Étapes de la commande">
      <li data-indicateur="1" aria-current="step">1. Coordonnées</li>
      <li data-indicateur="2">2. Titulaires et livraison</li>
      <li data-indicateur="3">3. Paiement</li>
    </ol>

    <div class="tunnel__grille">
      <div>
        <p class="alerte" role="alert" data-erreur hidden></p>

        <!-- Étape 1 -->
        <form class="etape" data-etape="1" novalidate>
          <h2>Vos coordonnées</h2>
          <p class="aide">Pas de compte à créer : vos billets et le suivi de commande vous sont envoyés par e-mail.</p>
          <div class="champs champs--deux">
            <label>Prénom<input name="prenom" autocomplete="given-name" required /></label>
            <label>Nom<input name="nom" autocomplete="family-name" required /></label>
            <label>E-mail<input name="email" type="email" autocomplete="email" required /></label>
            <label>Téléphone<input name="telephone" type="tel" autocomplete="tel" placeholder="+241 …" required /></label>
          </div>
          <button type="submit" class="button button--primary">Continuer</button>
        </form>

        <!-- Étape 2 -->
        <form class="etape" data-etape="2" hidden novalidate>
          <h2>Titulaires et livraison</h2>
          <p class="aide">Chaque pass et chaque billet est nominatif et non transférable : indiquez la personne qui l’utilisera. Son QR code, émis dès le paiement, est scanné à l’entrée de chaque site auquel il donne accès (pièce d’identité exigée).</p>
          <div data-titulaires></div>
          <fieldset class="retrait" data-bloc-livraison hidden>
            <legend>Livraison de vos articles</legend>
            <p class="aide" data-livraison-chargement>Chargement des modes de livraison…</p>
            <div class="livraison__modes" data-livraison-modes></div>
            <div data-livraison-eglise hidden>
              <label>Église du réseau<select name="pointLivraison" data-champ-livraison="eglise"></select></label>
              <p class="aide" data-eglise-detail></p>
            </div>
            <div class="champs" data-livraison-domicile hidden>
              <p class="aide" data-domicile-conditions></p>
              <label>Adresse de livraison (domicile ou lieu de travail : quartier, rue, repère)<textarea name="adresse" rows="2" data-champ-livraison="domicile"></textarea></label>
              <label>Téléphone joignable pour la livraison<input name="telephoneLivraison" type="tel" data-champ-livraison="domicile" /></label>
              <label>Précisions (facultatif)<input name="instructions" /></label>
            </div>
          </fieldset>
          <label class="case">
            <input type="checkbox" name="consentement" />
            <span>{r?.consentement?.texte ?? 'J’accepte d’être recontacté par le CRN au sujet de ses activités (facultatif).'}</span>
          </label>
          <label class="case">
            <input type="checkbox" name="cgv" required />
            <span>J’ai lu et j’accepte les <a href="/boutique/cgv" target="_blank">conditions générales de vente</a>.</span>
          </label>
          <div class="actions">
            <button type="button" class="button button--secondary" data-retour="1">Retour</button>
            <button type="submit" class="button button--primary" data-valider-commande>Valider et passer au paiement</button>
          </div>
        </form>

        <!-- Étape 3 -->
        <div class="etape" data-etape="3" hidden>
          <h2>Paiement</h2>
          <div class="reservation" data-reservation></div>
          <form data-formulaire-paiement novalidate>
            <ul class="moyens-acceptes">
              <li><strong>Mobile Money</strong> — opérateurs de plusieurs pays d’Afrique</li>
              <li><strong>Carte bancaire</strong> — depuis le Gabon ou l’étranger</li>
            </ul>
            <p class="aide">Vous choisissez votre moyen de paiement sur la page sécurisée de notre partenaire de paiement, puis vous revenez automatiquement au suivi de votre commande.</p>
            <button type="submit" class="button button--primary" data-payer>Payer</button>
          </form>
        </div>
      </div>

      <aside class="recap" aria-labelledby="recap-titre">
        <h2 id="recap-titre">Récapitulatif</h2>
        <ul data-recap-lignes></ul>
        <p class="recap__total"><span>Total</span> <strong data-recap-total></strong></p>
        <p class="aide" data-recap-euros></p>
      </aside>
    </div>
  </div>
</Boutique>

<script>
  import { formaterEUR, formaterXAF } from '../../lib/boutique-format';
  import { API_BOUTIQUE } from '../../lib/boutique-adresse';
  import { contientArticlesALivrer, lirePanier, type LignePanier } from '../../lib/boutique-panier';

  type Eglise = { id: number; nom: string; ville: string; pays: string; adresse: string | null; horaires: string | null; fraisXAF: number; delai: string | null };
  type Options = {
    eglises: Eglise[];
    domicile: { zone: string; fraisXAF: number; delai: string | null; conditions: string | null } | null;
    convention: { lieu: string | null; horaires: string | null } | null;
  };

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const panier = lirePanier();
  const erreur = $('[data-erreur]');
  const etat: { client?: Record<string, string>; numero?: string; jeton?: string; options?: Options } = {};
  const echapper = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  if (panier.length === 0) location.replace('/boutique');

  // ——— Récapitulatif (frais de livraison ajoutés dès que le mode est choisi) ———
  const sousTotal = panier.reduce((s, l) => s + l.prixXAF * l.quantite, 0);
  let total = sousTotal;
  const lignesRecap = panier.map((l) => `<li><span>${l.quantite} × ${echapper(l.nom)}${l.variante !== 'Unique' ? ` — ${echapper(l.variante)}` : ''}</span><span>${formaterXAF(l.prixXAF * l.quantite)}</span></li>`).join('');
  function majRecap(frais: number | null) {
    total = sousTotal + (frais ?? 0);
    $('[data-recap-lignes]').innerHTML = lignesRecap + (frais !== null ? `<li><span>Livraison</span><span>${frais ? formaterXAF(frais) : 'offerte'}</span></li>` : '');
    $('[data-recap-total]').textContent = formaterXAF(total);
    $('[data-recap-euros]').textContent = `soit environ ${formaterEUR(total)} (parité fixe 1 € = 655,957 F CFA)`;
  }
  majRecap(null);

  const montrerErreur = (message: string | null) => {
    erreur.hidden = !message;
    erreur.textContent = message ?? '';
    if (message) erreur.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  const allerA = (n: number) => {
    document.querySelectorAll<HTMLElement>('[data-etape]').forEach((e) => (e.hidden = e.dataset.etape !== String(n)));
    document.querySelectorAll<HTMLElement>('[data-indicateur]').forEach((i) => {
      if (i.dataset.indicateur === String(n)) i.setAttribute('aria-current', 'step');
      else i.removeAttribute('aria-current');
    });
    montrerErreur(null);
    const titre = document.querySelector<HTMLElement>(`[data-etape="${n}"] h2`);
    titre?.setAttribute('tabindex', '-1');
    titre?.focus();
  };

  const valider = (form: HTMLFormElement) => {
    if (form.checkValidity()) return true;
    const premier = form.querySelector<HTMLInputElement>(':invalid');
    montrerErreur(premier ? `Veuillez compléter : ${premier.closest('label')?.firstChild?.textContent?.trim() ?? 'le formulaire'}.` : 'Formulaire incomplet.');
    premier?.focus();
    return false;
  };

  // ——— Étape 1 ———
  $<HTMLFormElement>('[data-etape="1"]').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    if (!valider(form)) return;
    etat.client = Object.fromEntries(new FormData(form)) as Record<string, string>;
    construireTitulaires();
    allerA(2);
  });

  // ——— Étape 2 : un bloc par billet ———
  function blocTitulaire(l: LignePanier, indexLigne: number, n: number) {
    const id = `t-${indexLigne}-${n}`;
    const tailles = l.kitTailles
      .map((k) => `<label>Taille du ${echapper(k.nom.toLowerCase())} inclus<select name="${id}-taille" required><option value="">Choisir</option>${k.tailles.map((t) => `<option>${echapper(t)}</option>`).join('')}</select></label>`)
      .join('');
    const age = l.ageMin ? `<label>Date de naissance<input name="${id}-naissance" type="date" required></label><p class="aide">Réservé aux ${l.ageMin}–${l.ageMax} ans au 6 décembre 2026 (déclaratif).</p>` : '';
    return `<fieldset class="titulaire" data-titulaire data-ligne="${indexLigne}" data-id="${id}">
      <legend>${echapper(l.nom)}${l.variante !== 'Unique' ? ` — ${echapper(l.variante)}` : ''} · billet ${n + 1}/${l.quantite}</legend>
      ${indexLigne === premiereLigneNominative && n === 0 ? '<button type="button" class="moi" data-moi>C’est moi : reprendre mes coordonnées</button>' : ''}
      <div class="champs champs--deux">
        <label>Prénom<input name="${id}-prenom" required></label>
        <label>Nom<input name="${id}-nom" required></label>
        <label>Téléphone<input name="${id}-telephone" type="tel" required></label>
        <label>E-mail<input name="${id}-email" type="email" required></label>
        ${tailles}${age}
      </div>
    </fieldset>`;
  }
  const premiereLigneNominative = panier.findIndex((l) => l.nominatif);

  function construireTitulaires() {
    const conteneur = $('[data-titulaires]');
    if (conteneur.childElementCount) return;
    conteneur.innerHTML = panier.flatMap((l, i) => (l.nominatif ? Array.from({ length: l.quantite }, (_, n) => blocTitulaire(l, i, n)) : [])).join('');
    if (contientArticlesALivrer(panier)) chargerLivraison();
    conteneur.querySelector('[data-moi]')?.addEventListener('click', (e) => {
      const bloc = (e.currentTarget as HTMLElement).closest<HTMLElement>('[data-titulaire]')!;
      const id = bloc.dataset.id;
      for (const champ of ['prenom', 'nom', 'telephone', 'email']) {
        const input = bloc.querySelector<HTMLInputElement>(`[name="${id}-${champ}"]`);
        if (input) input.value = etat.client?.[champ] ?? '';
      }
    });
  }

  // ——— Étape 2 : livraison des articles (modes lus en direct auprès du back-office) ———
  const blocLivraison = $<HTMLFieldSetElement>('[data-bloc-livraison]');
  const fraisDe = (mode: string) => {
    const o = etat.options;
    if (!o) return null;
    if (mode === 'eglise') return o.eglises.find((e) => String(e.id) === $<HTMLSelectElement>('[name="pointLivraison"]').value)?.fraisXAF ?? null;
    if (mode === 'domicile') return o.domicile?.fraisXAF ?? null;
    return mode === 'convention' ? 0 : null;
  };
  const libelleFrais = (f: number) => (f ? `${formaterXAF(f)} de frais` : 'sans frais');

  function choisirMode(mode: string) {
    for (const m of ['eglise', 'domicile']) {
      const zone = blocLivraison.querySelector<HTMLElement>(`[data-livraison-${m}]`)!;
      zone.hidden = m !== mode;
      zone.querySelectorAll<HTMLInputElement>(`[data-champ-livraison="${m}"]`).forEach((c) => (c.required = m === mode));
    }
    if (mode === 'eglise') majEglise();
    majRecap(fraisDe(mode));
  }

  function majEglise() {
    const e = etat.options?.eglises.find((x) => String(x.id) === $<HTMLSelectElement>('[name="pointLivraison"]').value);
    $('[data-eglise-detail]').textContent = e
      ? [e.adresse, e.horaires ? `Retrait : ${e.horaires}` : null, `Délai : ${e.delai || 'à confirmer'}`, libelleFrais(e.fraisXAF)].filter(Boolean).join(' · ')
      : '';
    majRecap(fraisDe('eglise'));
  }

  async function chargerLivraison() {
    blocLivraison.hidden = false;
    let o: Options;
    try {
      const res = await fetch(`${API_BOUTIQUE}/api/boutique/livraison`);
      if (!res.ok) throw new Error();
      o = await res.json();
    } catch {
      $('[data-livraison-chargement]').textContent = 'Les modes de livraison n’ont pas pu être chargés : rechargez la page.';
      return;
    }
    etat.options = o;
    const modes: string[] = [];
    if (o.eglises.length) {
      const pays = [...new Set(o.eglises.map((e) => e.pays))];
      modes.push(`<label class="livraison__mode"><input type="radio" name="modeLivraison" value="eglise" required><span><strong>Dans une église du réseau</strong><br>${echapper(pays.join(', '))}</span></label>`);
      $('[name="pointLivraison"]').innerHTML =
        '<option value="">Choisir l’église</option>' +
        pays
          .map((p) => `<optgroup label="${echapper(p)}">${o.eglises.filter((e) => e.pays === p).map((e) => `<option value="${e.id}">${echapper(`${e.nom} — ${e.ville}`)}</option>`).join('')}</optgroup>`)
          .join('');
    }
    if (o.domicile) {
      modes.push(`<label class="livraison__mode"><input type="radio" name="modeLivraison" value="domicile" required><span><strong>À domicile ou au lieu de travail</strong><br>${echapper(o.domicile.zone)} uniquement, à titre exceptionnel · ${libelleFrais(o.domicile.fraisXAF)}</span></label>`);
      $('[data-domicile-conditions]').textContent = o.domicile.conditions ?? '';
    }
    if (o.convention) {
      modes.push(`<label class="livraison__mode"><input type="radio" name="modeLivraison" value="convention" required><span><strong>Retrait sur le lieu de la Convention</strong><br>${echapper(o.convention.lieu ?? 'Lieu à annoncer')}, ${echapper(o.convention.horaires ?? 'horaires à annoncer')} · sans frais</span></label>`);
    }
    $('[data-livraison-chargement]').hidden = modes.length > 0;
    if (!modes.length) $('[data-livraison-chargement]').textContent = 'Aucun mode de livraison n’est encore ouvert : contactez la hotline.';
    $('[data-livraison-modes]').innerHTML = modes.join('');
    blocLivraison.querySelectorAll<HTMLInputElement>('[name="modeLivraison"]').forEach((r) => r.addEventListener('change', () => choisirMode(r.value)));
    $('[name="pointLivraison"]').addEventListener('change', majEglise);
  }

  function saisieLivraison(champs: FormData) {
    if (blocLivraison.hidden) return undefined;
    const mode = String(champs.get('modeLivraison') ?? '');
    return {
      mode,
      ...(mode === 'eglise' ? { pointId: Number(champs.get('pointLivraison')) } : {}),
      ...(mode === 'domicile'
        ? { adresse: String(champs.get('adresse') ?? ''), telephone: String(champs.get('telephoneLivraison') ?? ''), instructions: String(champs.get('instructions') ?? '') }
        : {}),
    };
  }

  document.querySelector('[data-retour="1"]')!.addEventListener('click', () => allerA(1));

  $<HTMLFormElement>('[data-etape="2"]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    if (!valider(form)) return;
    const champs = new FormData(form);
    const titulaires = [...form.querySelectorAll<HTMLElement>('[data-titulaire]')].map((bloc) => {
      const id = bloc.dataset.id!;
      const v = (n: string) => String(champs.get(`${id}-${n}`) ?? '');
      return { ligne: Number(bloc.dataset.ligne), prenom: v('prenom'), nom: v('nom'), telephone: v('telephone'), email: v('email'), ...(v('naissance') ? { dateNaissance: v('naissance') } : {}), ...(v('taille') ? { tailleTeeShirt: v('taille') } : {}) };
    });
    const parametres = new URLSearchParams(sessionStorageLire('crn-provenance'));
    const bouton = form.querySelector<HTMLButtonElement>('[data-valider-commande]')!;
    bouton.disabled = true;
    bouton.textContent = 'Réservation en cours…';
    try {
      const res = await fetch(`${API_BOUTIQUE}/api/boutique/commandes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          client: etat.client,
          lignes: panier.map((l) => ({ varianteId: l.varianteId, quantite: l.quantite })),
          titulaires,
          livraison: saisieLivraison(champs),
          consentement: champs.get('consentement') === 'on',
          cgvAcceptees: champs.get('cgv') === 'on',
          provenance: { source: parametres.get('utm_source') ?? undefined, emplacement: parametres.get('utm_medium') ?? undefined, campagne: parametres.get('utm_campaign') ?? undefined },
        }),
      });
      const donnees = await res.json();
      if (!res.ok) throw new Error(donnees.erreur ?? 'Commande impossible.');
      etat.numero = donnees.numero;
      etat.jeton = donnees.jetonSuivi;
      if (donnees.totalXAF !== total) {
        $('[data-recap-total]').textContent = formaterXAF(donnees.totalXAF);
      }
      afficherReservation(donnees.reservationExpireA, donnees.totalXAF);
      $('[data-payer]').textContent = `Payer ${formaterXAF(donnees.totalXAF)}`;
      allerA(3);
    } catch (err) {
      montrerErreur((err as Error).message);
    } finally {
      bouton.disabled = false;
      bouton.textContent = 'Valider et passer au paiement';
    }
  });

  function sessionStorageLire(cle: string) {
    try {
      return sessionStorage.getItem(cle) ?? '';
    } catch {
      return '';
    }
  }

  // ——— Étape 3 : réservation (échéance réelle) et paiement ———
  function afficherReservation(expire: string, montant: number) {
    const bloc = $('[data-reservation]');
    const tic = () => {
      const reste = Math.max(0, new Date(expire).getTime() - Date.now());
      const m = Math.floor(reste / 60000);
      const s = Math.floor((reste % 60000) / 1000);
      bloc.innerHTML = reste > 0
        ? `<p>Commande <strong>${etat.numero}</strong> — <strong>${formaterXAF(montant)}</strong>. Vos places et articles sont réservés encore <strong>${m} min ${String(s).padStart(2, '0')} s</strong> : le prix est garanti pendant ce délai.</p>`
        : `<p><strong>Le délai de réservation est dépassé.</strong> Les places ont été rendues à la vente : <a href="/boutique/commande">recommencez votre commande</a>.</p>`;
      return reste > 0;
    };
    tic();
    const id = setInterval(() => !tic() && clearInterval(id), 1000);
  }

  $<HTMLFormElement>('[data-formulaire-paiement]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const bouton = (e.currentTarget as HTMLFormElement).querySelector<HTMLButtonElement>('[data-payer]')!;
    bouton.disabled = true;
    try {
      // Session de paiement chez l'agrégateur, puis redirection vers sa page sécurisée : le client
      // y choisit Mobile Money (son pays, son opérateur) ou carte, et revient au suivi de commande.
      const res = await fetch(`${API_BOUTIQUE}/api/boutique/commandes/${etat.numero}/paiement?t=${etat.jeton}`, { method: 'POST' });
      const donnees = await res.json();
      if (!res.ok || !donnees.redirection) throw new Error(donnees.erreur ?? 'Paiement impossible.');
      bouton.textContent = 'Ouverture de la page de paiement…';
      location.href = donnees.redirection;
    } catch (err) {
      montrerErreur((err as Error).message);
      bouton.disabled = false;
    }
  });
</script>

<style is:global>
  .tunnel {
    padding-top: var(--space-3);
  }

  .tunnel h1 {
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h2-mobile);
  }

  .etapes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 var(--space-3);
  }

  .etapes li {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--crn-gris-clair);
    color: var(--crn-gris);
    font-weight: 700;
    font-size: 16px;
  }

  .etapes li[aria-current='step'] {
    background: var(--crn-bleu-nuit);
    border-color: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
  }

  .tunnel__grille {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 960px) {
    .tunnel__grille {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
    .recap {
      position: sticky;
      top: 100px;
    }
  }

  .etape,
  .recap {
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }

  .etape h2,
  .recap h2 {
    margin-top: 0;
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h3-mobile);
  }

  .etape h2:focus {
    outline: none;
  }

  .aide {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .champs {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 640px) {
    .champs--deux {
      grid-template-columns: 1fr 1fr;
    }
  }

  .etape label,
  .champ-seul {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }

  .etape input:not([type='checkbox']):not([type='radio']),
  .etape select {
    min-height: var(--tap-target-min);
    border: 1.5px solid var(--crn-gris-clair);
    border-radius: var(--radius-control);
    padding: 0 12px;
    font: inherit;
    font-weight: 400;
    background: var(--crn-blanc);
  }

  .etape input:focus-visible,
  .etape select:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 1px;
  }

  .titulaire {
    border: 1px solid var(--crn-gris-clair);
