# Copier en .env (jamais commité) si besoin de surcharger les valeurs par défaut en local.

# Utilisé au build par src/lib/cms.ts pour lire le contenu depuis le back-office Payload
# (lot L3, backend/). Non exposé au navigateur.
# En local : http://localhost:3001/api — en production : URL interne/sous-domaine du back-office
# une fois son hébergement arbitré (voir ARB-PAGE-02 dans docs/conformite.md).
PAYLOAD_API_URL=http://localhost:3001/api

# Utilisé par le navigateur (widget NASTY, src/components/shared/ChatWidget.astro) pour joindre
# l'agent d'accueil en direct. Doit commencer par PUBLIC_ pour qu'Astro l'expose côté client.
PUBLIC_CHAT_API_URL=http://localhost:3001/api/chat
