# Copier en .env (jamais commité) si besoin de surcharger les valeurs par défaut en local.

# Utilisé au build par src/lib/cms.ts pour lire le contenu depuis le back-office Payload
# (lot L3, backend/). Non exposé au navigateur.
# En local : http://localhost:3001/api — en production : https://admin.crn-convention2026.events/api
# (back-office déployé sur un sous-domaine dédié, voir backend/README.md).
PAYLOAD_API_URL=http://localhost:3001/api

# Utilisé par le navigateur (widget NASTY, src/components/shared/ChatWidget.astro) pour joindre
# l'agent d'accueil en direct. Doit commencer par PUBLIC_ pour qu'Astro l'expose côté client.
# En production : https://admin.crn-convention2026.events/api/chat
PUBLIC_CHAT_API_URL=http://localhost:3001/api/chat

# Back-office qui sert l'API de la Boutique de la Convention (pages /boutique du site) : lu au
# build (catalogue, fiches produits, réglages, sélection « mis en avant » de l'accueil) et par le
# navigateur (panier, commande, paiement, suivi). Vide : back-office de production
# https://admin.crn-convention2026.events. En local : http://localhost:3001
PUBLIC_BOUTIQUE_API_URL=http://localhost:3001
