{
  "name": "@crn-boutique/api",
  "version": "0.1.0",
  "private": true,
  "description": "CRN Boutique — moteur e-commerce, API et back-office (Payload 3 + PostgreSQL). Billetterie nominative, droits d'accès par plateforme, paiements derrière l'interface PaymentProvider.",
  "type": "module",
  "scripts": {
    "db": "node scripts/postgres-local.mjs",
    "dev": "next dev --turbopack -p 3101",
    "build": "payload generate:types && next build",
    "start": "next start -p 3101",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "seed": "payload run scripts/seed.ts",
    "test": "vitest run",
    "test:concurrence": "payload run scripts/test-concurrence.ts",
    "test:scan": "payload run scripts/test-scan.ts"
  },
  "dependencies": {
    "@crn-boutique/domaine": "file:../domaine",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@payloadcms/db-postgres": "3.45.0",
    "@payloadcms/next": "3.45.0",
    "@payloadcms/richtext-lexical": "3.45.0",
    "@payloadcms/translations": "3.45.0",
    "graphql": "16.9.0",
    "next": "15.5.28",
    "payload": "3.45.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@embedded-postgres/windows-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-arm64": "16.14.0-beta.17",
    "@embedded-postgres/darwin-arm64": "16.14.0-beta.17",
    "@embedded-postgres/darwin-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-arm": "16.14.0-beta.17",
    "@embedded-postgres/linux-ia32": "16.14.0-beta.17",
    "@embedded-postgres/linux-ppc64": "16.14.0-beta.17"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "16.14.0-beta.17",
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@embedded-postgres/windows-x64": "16.14.0-beta.17"
  }
}
