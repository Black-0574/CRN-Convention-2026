# Copier en .env (jamais commité). Valeurs locales par défaut : base embedded-postgres (npm run db).
DATABASE_URI=postgres://boutique:boutique-local@127.0.0.1:5433/boutique
# Secret de session Payload — chaîne aléatoire longue (openssl rand -base64 32).
PAYLOAD_SECRET=change-me
# Secret de signature des jetons QR des billets (32 caractères minimum, jamais changé en cours de vente).
BILLETS_SECRET=change-me-change-me-change-me-change-me
# Secret de signature des liens de téléchargement des billets.
LIENS_SECRET=change-me-change-me-change-me-change-me
# Prestataire Mobile Money : « bac-a-sable » tant que l'agrégateur réel n'est pas raccordé.
PAIEMENT_PRESTATAIRE=bac-a-sable
PAIEMENT_BAC_A_SABLE_SECRET=change-me-change-me-change-me
# Adresse publique de la vitrine (liens dans les e-mails et les billets).
VITRINE_URL=http://localhost:4322
# Démonstration locale : affiche aussi les produits dont le prix n'est pas encore validé, marqués
# « Aperçu — tarif en attente de validation ». Refusé au démarrage si NODE_ENV=production.
BOUTIQUE_DEMO=1
