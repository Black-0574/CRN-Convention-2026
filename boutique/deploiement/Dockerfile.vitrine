# Vitrine (Astro, rendu serveur). Construit depuis la racine du dépôt : reprend src/styles du site.
FROM node:22.20.0-alpine AS construction
WORKDIR /depot
COPY src/styles ./src/styles
COPY boutique/domaine ./boutique/domaine
COPY boutique/vitrine/package.json boutique/vitrine/package-lock.json ./boutique/vitrine/
RUN cd boutique/vitrine && npm ci
COPY boutique/vitrine ./boutique/vitrine
RUN cd boutique/vitrine && npm run build

FROM node:22.20.0-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=construction /depot/boutique/vitrine/dist ./dist
COPY --from=construction /depot/boutique/vitrine/node_modules ./node_modules
USER node
EXPOSE 4322
CMD ["node", "dist/server/entry.mjs"]
