---
/*
  Contrôle d'accès des agents COM Boutique (Palier 1 : en ligne ; hors ligne au Palier 2).
  Connexion nominative (compte du back-office, rôle COM Boutique), choix de la plateforme et du
  poste, lecture du QR par la caméra (BarcodeDetector) ou saisie du code. Résultat affiché en grand
  avec le nom du titulaire pour le contrôle d'identité ; second passage refusé avec l'heure et le
  poste du premier.
*/
import Boutique from '../layouts/Boutique.astro';
---

<Boutique title="Contrôle d’accès">
  <div class="container scan">
    <h1>Contrôle d’accès</h1>

    <form class="carte-scan" data-connexion hidden>
      <h2>Connexion agent</h2>
      <label>E-mail<input name="email" type="email" autocomplete="username" required /></label>
      <label>Mot de passe<input name="password" type="password" autocomplete="current-password" required /></label>
      <button class="button button--primary" type="submit">Se connecter</button>
      <p class="message" role="alert" data-message-connexion></p>
    </form>

    <div data-poste hidden>
      <div class="carte-scan">
        <div class="reglages">
          <label>Plateforme<select data-plateforme></select></label>
          <label>Poste<input data-nom-poste placeholder="ex. Église Centrale — porte 1" /></label>
        </div>
        <div class="camera">
          <video data-video playsinline muted></video>
          <button class="button button--primary" type="button" data-activer-camera>Activer la caméra</button>
        </div>
        <form class="saisie" data-saisie>
          <label>Code du billet<input data-code autocomplete="off" spellcheck="false" placeholder="Coller ou saisir le code du QR" /></label>
          <button class="button button--secondary" type="submit">Vérifier</button>
        </form>
      </div>
      <div class="resultat" data-resultat hidden role="status" aria-live="assertive">
        <p class="resultat__titre" data-resultat-titre></p>
        <p class="resultat__titulaire" data-resultat-titulaire></p>
        <p data-resultat-detail></p>
      </div>
    </div>
  </div>
</Boutique>

<script>
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const connexion = $<HTMLFormElement>('[data-connexion]');
  const poste = $('[data-poste]');
  const selectPlateforme = $<HTMLSelectElement>('[data-plateforme]');
  const nomPoste = $<HTMLInputElement>('[data-nom-poste]');
  let dernierCode = '';
  let dernierInstant = 0;

  try {
    nomPoste.value = localStorage.getItem('crn-scan-poste') ?? '';
  } catch {
    /* stockage indisponible */
  }
  nomPoste.addEventListener('change', () => {
    try {
      localStorage.setItem('crn-scan-poste', nomPoste.value);
    } catch {
      /* stockage indisponible */
    }
  });

  async function chargerPlateformes() {
    const res = await fetch('/api/boutique/scan/plateformes', { credentials: 'include' });
    if (res.status === 401) {
      connexion.hidden = false;
      poste.hidden = true;
      return;
    }
    const liste: { code: string; nom: string }[] = await res.json();
    selectPlateforme.innerHTML = liste.map((p) => `<option value="${p.code}">${p.nom.replace(/</g, '&lt;')}</option>`).join('');
    try {
      const memo = localStorage.getItem('crn-scan-plateforme');
      if (memo) selectPlateforme.value = memo;
    } catch {
      /* stockage indisponible */
    }
    connexion.hidden = true;
    poste.hidden = false;
  }
  selectPlateforme.addEventListener('change', () => {
    try {
      localStorage.setItem('crn-scan-plateforme', selectPlateforme.value);
    } catch {
      /* stockage indisponible */
    }
  });

  connexion.addEventListener('submit', async (e) => {
    e.preventDefault();
    const champs = Object.fromEntries(new FormData(connexion));
    const res = await fetch('/api/utilisateurs/login', { method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(champs) });
    $('[data-message-connexion]').textContent = res.ok ? '' : 'Identifiants incorrects ou compte verrouillé.';
    if (res.ok) chargerPlateformes();
  });

  const TITRES: Record<string, string> = {
    accepte: 'Entrée acceptée',
    refuse_deja_utilise: 'Refusé — déjà utilisé',
    refuse_plateforme: 'Refusé — non inclus',
    refuse_annule: 'Refusé — billet annulé',
    refuse_invalide: 'Refusé — billet invalide',
  };

  async function verifier(code: string) {
    code = code.trim();
    if (!code) return;
    // Évite de compter deux fois le même QR resté devant la caméra.
    if (code === dernierCode && Date.now() - dernierInstant < 4000) return;
    dernierCode = code;
    dernierInstant = Date.now();
    if (!nomPoste.value.trim()) {
      nomPoste.focus();
      return alert('Indiquez d’abord le nom du poste.');
    }
    const res = await fetch('/api/boutique/scan', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jeton: code, plateforme: selectPlateforme.value, poste: nomPoste.value.trim() }),
    });
    const r = await res.json();
    const bloc = $('[data-resultat]');
    bloc.hidden = false;
    bloc.dataset.resultat = r.resultat ?? 'erreur';
    $('[data-resultat-titre]').textContent = TITRES[r.resultat] ?? r.erreur ?? 'Erreur';
    $('[data-resultat-titulaire]').textContent = r.titulaire ? `${r.titulaire.prenom} ${r.titulaire.nom} — ${r.titulaire.produit}` : '';
    $('[data-resultat-detail]').textContent = r.message ?? '';
    if (navigator.vibrate) navigator.vibrate(r.resultat === 'accepte' ? 80 : [200, 100, 200]);
  }

  $<HTMLFormElement>('[data-saisie]').addEventListener('submit', (e) => {
    e.preventDefault();
    dernierCode = '';
    verifier($<HTMLInputElement>('[data-code]').value);
  });

  $('[data-activer-camera]').addEventListener('click', async (e) => {
    const Detecteur = (window as unknown as { BarcodeDetector?: new (o: { formats: string[] }) => { detect: (s: HTMLVideoElement) => Promise<{ rawValue: string }[]> } }).BarcodeDetector;
    if (!Detecteur) return alert('Lecture du QR non prise en charge par ce navigateur : utilisez la saisie du code, ou Chrome sur Android.');
    const video = $<HTMLVideoElement>('[data-video]');
    video.srcObject = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
    await video.play();
    (e.currentTarget as HTMLElement).hidden = true;
    const detecteur = new Detecteur({ formats: ['qr_code'] });
    const boucle = async () => {
      try {
        const [qr] = await detecteur.detect(video);
        if (qr) await verifier(qr.rawValue);
      } catch {
        /* image non lisible : on continue */
      }
      setTimeout(boucle, 300);
    };
    boucle();
  });

  chargerPlateformes();
</script>

<style>
  .scan {
    padding-top: var(--space-3);
    max-width: 720px;
  }

  .scan h1 {
    color: var(--crn-bleu-nuit);
  }

  .carte-scan {
    display: grid;
    gap: var(--space-2);
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }

  .carte-scan h2 {
    margin: 0;
    color: var(--crn-bleu-nuit);
  }

  .carte-scan label {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }

  .carte-scan input,
  .carte-scan select {
    min-height: var(--tap-target-min);
    border: 1.5px solid var(--crn-gris-clair);
    border-radius: var(--radius-control);
    padding: 0 12px;
    font: inherit;
    font-weight: 400;
  }

  .reglages {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .reglages {
      grid-template-columns: 1fr 1fr;
    }
  }

  .camera video {
    width: 100%;
    max-height: 320px;
    background: var(--crn-noir);
    border-radius: var(--radius-card-sm);
    object-fit: cover;
  }

  .saisie {
    display: grid;
    gap: 8px;
  }

  .message {
    margin: 0;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  /* Accepté : bleu nuit ; refusé : or sur fond noir — palette GBIS, jamais de rouge. */
  .resultat {
    margin-top: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-card);
    text-align: center;
    background: var(--crn-noir);
    color: var(--crn-or-lumiere);
    border: 3px solid var(--crn-or);
  }

  .resultat[data-resultat='accepte'] {
    background: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
    border-color: var(--crn-bleu-nuit-profond);
  }

  .resultat__titre {
    margin: 0;
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: var(--text-h2-mobile);
  }

  .resultat__titulaire {
    font-size: var(--text-h4-mobile);
    font-weight: 700;
    margin: 8px 0;
  }
</style>
