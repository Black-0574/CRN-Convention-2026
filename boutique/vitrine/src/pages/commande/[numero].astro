---
/*
  Suivi d'une commande (lien personnel envoyé par e-mail : numéro + jeton de suivi). Billets à
  télécharger une fois le paiement confirmé, articles à retirer, état de la réservation. Mise à jour
  automatique tant que le paiement est en attente.
*/
import Boutique from '../../layouts/Boutique.astro';
import { API_URL } from '../../lib/api';
import { formaterXAF } from '../../lib/format';

const numero = Astro.params.numero ?? '';
const jeton = Astro.url.searchParams.get('t') ?? '';
const res = await fetch(`${API_URL}/api/boutique/commandes/${encodeURIComponent(numero)}?t=${encodeURIComponent(jeton)}`);
if (!res.ok) return new Response(null, { status: 404, statusText: 'Commande introuvable' });
const c = await res.json();

const libelles: Record<string, { titre: string; texte: string }> = {
  en_attente: { titre: 'Paiement en attente', texte: 'Validez le paiement sur votre téléphone. Cette page se met à jour toute seule.' },
  payee: { titre: 'Merci, votre commande est confirmée', texte: 'Vos billets sont prêts. Ils vous ont aussi été envoyés par e-mail.' },
  echouee: { titre: 'Paiement non abouti', texte: 'Le paiement a été refusé ou annulé. Aucun montant n’a été débité ; vos places ont été rendues à la vente.' },
  expiree: { titre: 'Délai de réservation dépassé', texte: 'La réservation de 15 minutes a expiré avant le paiement : vos places ont été rendues à la vente.' },
  a_verifier: { titre: 'Paiement en cours de vérification', texte: 'Votre paiement est arrivé après la fin de la réservation. L’équipe de la boutique vérifie votre commande et vous recontacte.' },
  remboursee: { titre: 'Commande remboursée', texte: 'Cette commande a été remboursée ; ses billets ne sont plus valables.' },
};
const etat = libelles[c.statut] ?? libelles.en_attente!;
type Ligne = { libelle: string; quantite: number; prixUnitaireXAF: number; inclus: boolean; aRetirer: boolean };
const lignes = c.lignes as Ligne[];
const aRetirer = lignes.filter((l) => l.aRetirer);
const lienCourriel = (f: string) => `/api/boutique/dev/courriels/${encodeURIComponent(f)}`;
---

<Boutique title={`Commande ${c.numero}`}>
  <div class="container suivi" data-statut={c.statut} data-numero={c.numero} data-jeton={jeton}>
    <p class="suivi__numero">Commande {c.numero}</p>
    <h1>{etat.titre}</h1>
    <p class="suivi__texte">{etat.texte}</p>

    {c.billets.length > 0 && (
      <section class="bloc">
        <h2>Vos billets</h2>
        <ul class="billets">
          {c.billets.map((b: { numero: string; titulaire: string; lien: string }) => (
            <li>
              <div><strong>{b.titulaire}</strong><span>Billet {b.numero}</span></div>
              <a class="button button--primary" href={b.lien} target="_blank" rel="noopener">Télécharger (PDF)</a>
            </li>
          ))}
        </ul>
        <p class="aide">Billet nominatif et non transférable : présentez-le (imprimé ou sur téléphone) avec une pièce d’identité. Le QR code est scanné à chaque entrée.</p>
      </section>
    )}

    {c.statut === 'payee' && aRetirer.length > 0 && (
      <section class="bloc">
        <h2>Kits et articles à retirer</h2>
        <ul>{aRetirer.map((l) => <li>{l.libelle} × {l.quantite}</li>)}</ul>
        <p>Retrait sur le lieu de la Convention : <strong>{c.retrait.lieu ?? 'lieu à annoncer'}</strong>, {c.retrait.horaires ?? 'horaires à annoncer'}.</p>
      </section>
    )}

    <section class="bloc">
      <h2>Détail</h2>
      <ul class="detail">
        {lignes.map((l) => (
          <li><span>{l.quantite} × {l.libelle}</span><span>{l.inclus ? 'inclus' : formaterXAF(l.quantite * l.prixUnitaireXAF)}</span></li>
        ))}
      </ul>
      <p class="detail__total"><span>Total</span><strong>{formaterXAF(c.totalXAF)}</strong></p>
    </section>

    {c.courrielsLocaux?.length > 0 && (
      <section class="bloc bloc--demo">
        <h2>E-mails envoyés (démonstration locale)</h2>
        <ul>{c.courrielsLocaux.map((f: string) => <li><a href={lienCourriel(f)} target="_blank">{f.split('--')[1]}</a></li>)}</ul>
      </section>
    )}

    <p><a class="button button--secondary" href="/">Retour à la boutique</a></p>
  </div>
</Boutique>

<script>
  const bloc = document.querySelector<HTMLElement>('[data-statut]');
  if (bloc?.dataset.statut === 'en_attente') {
    const id = setInterval(async () => {
      const res = await fetch(`/api/boutique/commandes/${bloc.dataset.numero}?t=${bloc.dataset.jeton}`);
      if (res.ok && (await res.json()).statut !== 'en_attente') {
        clearInterval(id);
        location.reload();
      }
    }, 3000);
  }
</script>

<style>
  .suivi {
    padding-top: var(--space-6);
    max-width: 820px;
  }

  .suivi__numero {
    margin: 0;
    font-weight: 700;
    color: var(--crn-or-profond);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .suivi h1 {
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h2-mobile);
    margin: 8px 0;
  }

  .suivi__texte {
    font-size: var(--text-p);
  }

  .bloc {
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    margin: var(--space-3) 0;
  }

  .bloc h2 {
    margin-top: 0;
    font-size: var(--text-h4);
    color: var(--crn-bleu-nuit);
  }

  .bloc--demo {
    border-style: dashed;
    border-color: var(--crn-or);
    background: var(--crn-creme);
  }

  .billets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: grid;
    gap: 12px;
  }

  .billets li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-left: 3px solid var(--crn-or);
    background: var(--crn-creme);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
  }

  .billets li div {
    display: grid;
  }

  .billets li span {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .aide {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .detail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .detail li,
  .detail__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .detail__total {
    border-top: 1px solid var(--crn-gris-clair);
    padding-top: 12px;
    margin-bottom: 0;
    font-size: 20px;
  }
</style>
