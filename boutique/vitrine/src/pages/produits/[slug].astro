---
import CompteARebours from '../../components/CompteARebours.astro';
import Boutique from '../../layouts/Boutique.astro';
import { produit as lireProduit } from '../../lib/api';
import { creneau, dernierJour, formaterEUR, formaterXAF } from '../../lib/format';

const donnees = await lireProduit(Astro.params.slug ?? '');
if (!donnees) return new Response(null, { status: 404, statusText: 'Produit introuvable' });
const { produit: p, demo } = donnees;

const maintenant = new Date();
const palierCourant = p.paliers.find((pa) => new Date(pa.debut) <= maintenant && maintenant < new Date(pa.fin));
const palierSuivant = p.paliers.find((pa) => new Date(pa.debut) > maintenant);
const choixVariante = p.variantes.length > 1;
const vendable = p.prixXAF !== null && !p.indisponible;
const etiquetteType = { pass: 'Pass nominatif', ticket: 'Billet nominatif', physique: 'Article officiel', numerique: 'Produit numérique' }[p.type];

// Données reprises par le panier (rien n'y fait foi : le serveur revérifie à la commande).
const pourPanier = {
  slug: p.slug,
  nom: p.nom,
  prixXAF: p.prixXAF,
  nominatif: p.nominatif,
  ageMin: p.ageMin,
  ageMax: p.ageMax,
  kitTailles: p.kit.filter((k) => k.tailles.length > 0).map((k) => ({ nom: k.nom, tailles: k.tailles })),
  photo: p.photos[0]?.carte ?? null,
  variantes: p.variantes,
};
---

<Boutique title={p.nom} description={p.resume ?? `${p.nom} — Convention CRN 2026.`} demo={demo}>
  <div class="container fiche">
    <nav class="fil" aria-label="Fil d’Ariane"><a href="/">Boutique</a> <span aria-hidden="true">/</span> <span>{p.nom}</span></nav>

    <div class="fiche__grille">
      <div class="fiche__galerie">
        {p.photos.length > 0 ? (
          <>
            <img class="fiche__photo" src={p.photos[0]!.fiche} alt={p.photos[0]!.alt} width="960" height="960" data-photo-principale />
            {p.photos.length > 1 && (
              <div class="fiche__miniatures">
                {p.photos.map((ph, i) => (
                  <button type="button" data-miniature={ph.fiche} aria-label={`Voir la photo ${i + 1}`}><img src={ph.carte} alt="" width="96" height="96" loading="lazy" /></button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="fiche__cadre" role="img" aria-label="Photo à venir">
            <span class="fiche__cadre-sigle">CRN</span>
            <span>Convention 2026</span>
            <span class="fiche__cadre-note">Photo réelle à venir</span>
          </div>
        )}
      </div>

      <div class="fiche__infos">
        <p class="fiche__type">{etiquetteType}</p>
        {p.apercu && <p class="fiche__apercu">Aperçu — tarif en attente de validation par le CRN</p>}
        <h1 class="fiche__nom">{p.nom}</h1>
        {p.badge && <span class="fiche__badge">{p.badge}</span>}

        <div class="fiche__prix">
          {p.prixXAF !== null ? (
            <>
              <strong>{formaterXAF(p.prixXAF)}</strong>
              <span>soit {formaterEUR(p.prixXAF)}</span>
            </>
          ) : (
            <strong>Tarif à annoncer</strong>
          )}
        </div>

        {palierCourant && palierSuivant && (
          <div class="fiche__palier">
            <p>Tarif valable jusqu’au <strong>{dernierJour(palierCourant.fin)}</strong> inclus, puis <strong>{formaterXAF(palierSuivant.prixXAF)}</strong>.</p>
            <CompteARebours cible={palierSuivant.debut} libelle="Avant le prochain tarif" echu="Nouveau tarif en vigueur : rechargez la page." />
          </div>
        )}

        {p.resume && <p class="fiche__resume">{p.resume}</p>}

        {vendable ? (
          <form class="fiche__achat" data-formulaire-achat>
            {choixVariante && (
              <fieldset class="fiche__variantes">
                <legend>{p.type === 'physique' ? 'Taille' : 'Choix'}</legend>
                <div class="fiche__pastilles">
                  {p.variantes.map((v, i) => (
                    <label class:list={['fiche__variante', { 'fiche__variante--epuisee': v.disponible === 0 }]}>
                      <input type="radio" name="variante" value={v.id} checked={i === p.variantes.findIndex((x) => x.disponible !== 0)} disabled={v.disponible === 0} required />
                      <span>{v.libelle}</span>
                      {v.disponible !== null && v.disponible > 0 && v.disponible <= 5 && <span class="fiche__reste">plus que {v.disponible}</span>}
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            {!choixVariante && <input type="hidden" name="variante" value={p.variantes[0]?.id} />}
            <div class="fiche__quantite">
              <label for="quantite">Quantité</label>
              <input id="quantite" name="quantite" type="number" min="1" max="20" value="1" inputmode="numeric" />
            </div>
            {p.nominatif && <p class="fiche__note">Un billet par personne : vous indiquerez le nom de chaque titulaire à la commande{p.ageMin ? ` (réservé aux ${p.ageMin}–${p.ageMax} ans)` : ''}.</p>}
            <button type="submit" class="button button--primary fiche__ajouter">Ajouter au panier</button>
            <p class="fiche__confirmation" role="status" data-confirmation></p>
          </form>
        ) : (
          <p class="fiche__indisponible">{p.indisponible ?? 'Indisponible pour le moment.'}</p>
        )}

        {p.plateformes.length > 0 && (
          <section class="fiche__section">
            <h2>Ce que comprend ce {p.type === 'pass' ? 'pass' : 'billet'}</h2>
            <ul class="fiche__seances">
              {p.plateformes.map((pl) => (
                <li><strong>{pl.nom}</strong><span>{creneau(pl.debut, pl.fin)} · {pl.lieu ?? 'lieu à annoncer'}</span></li>
              ))}
            </ul>
          </section>
        )}
        {p.kit.length > 0 && (
          <section class="fiche__section">
            <h2>Kit inclus</h2>
            <ul>{p.kit.map((k) => <li>{k.nom}{k.quantite > 1 ? ` × ${k.quantite}` : ''}{k.tailles.length > 0 ? ' (taille au choix de chaque titulaire)' : ''}</li>)}</ul>
            <p class="fiche__note">À retirer sur le lieu de la Convention.</p>
          </section>
        )}
        {p.description && (
          <section class="fiche__section">
            <h2>Description</h2>
            <p class="fiche__description">{p.description}</p>
          </section>
        )}
      </div>
    </div>
  </div>
  <script type="application/json" data-produit-panier set:html={JSON.stringify(pourPanier).replace(/</g, '\\u003c')} />
</Boutique>

<script>
  import { ajouter, ouvrirPanier } from '../../lib/panier';

  const donnees = JSON.parse(document.querySelector('[data-produit-panier]')?.textContent ?? 'null');
  const formulaire = document.querySelector<HTMLFormElement>('[data-formulaire-achat]');
  formulaire?.addEventListener('submit', (e) => {
    e.preventDefault();
    const champs = new FormData(formulaire);
    const varianteId = Number(champs.get('variante'));
    const variante = donnees.variantes.find((v: { id: number }) => v.id === varianteId);
    const quantite = Math.max(1, Math.min(20, Number(champs.get('quantite')) || 1));
    ajouter({
      varianteId,
      slug: donnees.slug,
      nom: donnees.nom,
      variante: variante?.libelle ?? 'Unique',
      prixXAF: donnees.prixXAF,
      quantite,
      nominatif: donnees.nominatif,
      ageMin: donnees.ageMin,
      ageMax: donnees.ageMax,
      kitTailles: donnees.kitTailles,
      photo: donnees.photo,
    });
    const confirmation = formulaire.querySelector('[data-confirmation]');
    if (confirmation) confirmation.textContent = `${quantite} × ${donnees.nom} ajouté${quantite > 1 ? 's' : ''} au panier.`;
    ouvrirPanier();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-miniature]').forEach((b) =>
    b.addEventListener('click', () => {
      const principale = document.querySelector<HTMLImageElement>('[data-photo-principale]');
      if (principale) principale.src = b.dataset.miniature!;
    }),
  );
</script>

<style>
  .fiche {
    padding-top: var(--space-3);
  }

  .fil {
    font-size: 16px;
    color: var(--crn-gris);
    margin-bottom: var(--space-2);
  }

  .fil a {
    color: var(--crn-bleu-nuit);
  }

  .fiche__grille {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 900px) {
    .fiche__grille {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .fiche__galerie {
      position: sticky;
      top: 100px;
    }
  }

  .fiche__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    background: var(--crn-creme);
  }

  .fiche__miniatures {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .fiche__miniatures button {
    padding: 0;
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-control);
    overflow: hidden;
    background: none;
    cursor: pointer;
  }

  .fiche__cadre {
    aspect-ratio: 1;
    border-radius: var(--radius-card);
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
    border: 1.5px dashed var(--crn-or);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--crn-blanc);
  }

  .fiche__cadre-sigle {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: 49px;
    color: var(--crn-or-lumiere);
    letter-spacing: 0.08em;
  }

  .fiche__cadre-note {
    color: rgba(255, 255, 255, 0.75);
  }

  .fiche__type {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 16px;
    color: var(--crn-or-profond);
  }

  .fiche__apercu {
    display: inline-block;
    margin: 8px 0 0;
    background: var(--crn-or-lumiere);
    color: var(--crn-noir);
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .fiche__nom {
    margin: 8px 0;
    color: var(--crn-bleu-nuit);
    font-size: var(--text-h2-mobile);
    line-height: 1.15;
  }

  .fiche__badge {
    display: inline-block;
    font-weight: 700;
    color: var(--crn-or-profond);
    border: 1px solid var(--crn-or-lumiere);
    border-radius: var(--radius-pill);
    padding: 2px 12px;
  }

  .fiche__prix {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin: var(--space-2) 0;
  }

  .fiche__prix strong {
    font-size: var(--text-h3-mobile);
    color: var(--crn-noir);
  }

  .fiche__prix span {
    color: var(--crn-gris);
  }

  .fiche__palier {
    background: var(--crn-blanc);
    border: 1px solid var(--crn-or-lumiere);
    border-radius: var(--radius-card-sm);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .fiche__palier p {
    margin-top: 0;
  }

  .fiche__resume {
    font-size: var(--text-p);
  }

  .fiche__achat {
    display: grid;
    gap: var(--space-2);
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card-sm);
    padding: var(--space-2);
  }

  .fiche__variantes {
    border: none;
    margin: 0;
    padding: 0;
  }

  .fiche__variantes legend {
    font-weight: 700;
    margin-bottom: 8px;
  }

  .fiche__pastilles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fiche__variante {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-height: var(--tap-target-min);
    justify-content: center;
    padding: 6px 16px;
    border: 1.5px solid var(--crn-gris-clair);
    border-radius: var(--radius-control);
    cursor: pointer;
    font-weight: 700;
  }

  .fiche__variante input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .fiche__variante:has(input:checked) {
    border-color: var(--crn-bleu-nuit);
    background: var(--crn-bleu-nuit);
    color: var(--crn-blanc);
  }

  .fiche__variante:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .fiche__variante--epuisee {
    opacity: 0.45;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .fiche__reste {
    font-weight: 400;
    font-size: 16px;
  }

  .fiche__quantite {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fiche__quantite label {
    font-weight: 700;
  }

  .fiche__quantite input {
    width: 88px;
    min-height: var(--tap-target-min);
    border: 1.5px solid var(--crn-gris-clair);
    border-radius: var(--radius-control);
    padding: 0 12px;
    font: inherit;
  }

  .fiche__ajouter {
    justify-content: center;
  }

  .fiche__note {
    color: var(--crn-gris);
    margin: 0;
    font-size: 16px;
  }

  .fiche__confirmation {
    margin: 0;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  .fiche__indisponible {
    font-weight: 700;
    color: var(--crn-bleu-nuit);
    padding: var(--space-2);
    border: 1px solid var(--crn-or);
    border-radius: var(--radius-card-sm);
    background: var(--crn-blanc);
  }

  .fiche__section {
    margin-top: var(--space-3);
  }

  .fiche__section h2 {
    font-size: var(--text-h4-mobile);
    color: var(--crn-bleu-nuit);
    margin-bottom: 8px;
  }

  .fiche__seances {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .fiche__seances li {
    display: grid;
    padding: 8px 12px;
    background: var(--crn-blanc);
    border-left: 3px solid var(--crn-or);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
  }

  .fiche__seances span {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .fiche__seances span::first-letter {
    text-transform: uppercase;
  }

  .fiche__description {
    white-space: pre-line;
  }

  @media (min-width: 768px) {
    .fiche__nom {
      font-size: var(--text-h2);
    }
  }
</style>
