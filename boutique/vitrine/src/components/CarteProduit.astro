---
/*
  Carte produit : photo (zoom 1,05 en 400 ms au survol et bascule vers la seconde photo), nom,
  prix du palier en vigueur en F CFA et en euros, badge sobre, « Aperçu rapide » et « Favoris »
  apparaissant en fondu + translation de 10 px. Photo absente : cadre neutre marqué (jamais
  d'image inventée). Animations neutralisées par prefers-reduced-motion.
*/
import type { VueProduit } from '../lib/api';
import { formaterEUR, formaterXAF } from '../lib/format';

interface Props {
  produit: VueProduit;
}
const { produit: p } = Astro.props;
const [photo1, photo2] = p.photos;
---

<article class="carte" data-carte={p.slug}>
  <div class="carte__media">
    {photo1 ? (
      <>
        <img class="carte__photo" src={photo1.carte} alt={photo1.alt} width="480" height="480" loading="lazy" />
        {photo2 && <img class="carte__photo carte__photo--seconde" src={photo2.carte} alt="" width="480" height="480" loading="lazy" />}
      </>
    ) : (
      <div class="carte__cadre" aria-hidden="true">
        <span class="carte__cadre-sigle">CRN</span>
        <span class="carte__cadre-note">Photo à venir</span>
      </div>
    )}
    {p.apercu && <span class="carte__apercu">Aperçu — tarif à valider</span>}
    <div class="carte__actions">
      <button type="button" class="carte__action" data-apercu-rapide={p.slug} aria-label={`Aperçu rapide : ${p.nom}`}>Aperçu rapide</button>
      <button type="button" class="carte__action carte__favori" data-favori={p.slug} aria-pressed="false" aria-label={`Ajouter ${p.nom} aux favoris`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9Z" /></svg>
      </button>
    </div>
  </div>
  <div class="carte__corps">
    {p.badge && <span class="carte__badge">{p.badge}</span>}
    <h3 class="carte__nom"><a href={`/produits/${p.slug}`}>{p.nom}</a></h3>
    {p.resume && <p class="carte__resume">{p.resume}</p>}
    <p class="carte__prix">
      {p.prixXAF !== null ? (
        <>
          <strong>{formaterXAF(p.prixXAF)}</strong> <span class="carte__euros">{formaterEUR(p.prixXAF)}</span>
        </>
      ) : (
        <strong>À annoncer</strong>
      )}
    </p>
    {p.indisponible && <p class="carte__etat">{p.indisponible}</p>}
    <a class="button button--secondary carte__voir" href={`/produits/${p.slug}`}>Voir le produit</a>
  </div>
  <template data-gabarit-apercu={p.slug}>
    <h2>{p.nom}</h2>
    {p.resume && <p>{p.resume}</p>}
    <p><strong>{p.prixXAF !== null ? formaterXAF(p.prixXAF) : 'À annoncer'}</strong>{p.prixXAF !== null && <span> · {formaterEUR(p.prixXAF)}</span>}</p>
    {p.plateformes.length > 0 && <p>{p.plateformes.length} séance{p.plateformes.length > 1 ? 's' : ''} incluse{p.plateformes.length > 1 ? 's' : ''}{p.kit.length > 0 && ` · ${p.kit.map((k) => k.nom.toLowerCase()).join(', ')} inclus`}</p>}
    <a class="button button--primary" href={`/produits/${p.slug}`}>Voir le produit</a>
  </template>
</article>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    background: var(--crn-blanc);
    border: 1px solid var(--crn-gris-clair);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    height: 100%;
  }

  .carte__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--crn-creme);
  }

  .carte__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms ease;
  }

  .carte__photo--seconde {
    opacity: 0;
  }

  .carte:hover .carte__photo {
    transform: scale(1.05);
  }

  .carte:hover .carte__photo--seconde {
    opacity: 1;
  }

  .carte__cadre {
    position: absolute;
    inset: 16px;
    border: 1.5px dashed var(--crn-or);
    border-radius: var(--radius-card-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: linear-gradient(160deg, var(--crn-bleu-nuit) 0%, var(--crn-bleu-nuit-profond) 100%);
  }

  .carte__cadre-sigle {
    font-family: var(--font-titrage);
    font-weight: 700;
    font-size: 39px;
    color: var(--crn-or-lumiere);
    letter-spacing: 0.08em;
  }

  .carte__cadre-note {
    color: var(--crn-blanc);
    font-size: 16px;
  }

  .carte__apercu {
    position: absolute;
    left: 12px;
    top: 12px;
    background: var(--crn-or-lumiere);
    color: var(--crn-noir);
    font-weight: 700;
    font-size: 16px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .carte__actions {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carte:hover .carte__actions,
  .carte:focus-within .carte__actions {
    opacity: 1;
    transform: translateY(0);
  }

  /* Écrans tactiles : actions toujours visibles (pas de survol). */
  @media (hover: none) {
    .carte__actions {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carte__photo,
    .carte__actions {
      transition: none;
    }
    .carte:hover .carte__photo {
      transform: none;
    }
  }

  .carte__action {
    min-height: var(--tap-target-min);
    min-width: var(--tap-target-min);
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--crn-gris-clair);
    background: rgba(255, 255, 255, 0.95);
    color: var(--crn-bleu-nuit);
    font-family: var(--font-labeur);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .carte__favori[aria-pressed='true'] {
    background: var(--crn-bleu-nuit);
    color: var(--crn-or-lumiere);
  }

  .carte__favori[aria-pressed='true'] svg {
    fill: currentColor;
  }

  .carte__corps {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-2) var(--space-2) var(--space-3);
    flex: 1;
  }

  .carte__badge {
    align-self: flex-start;
    font-size: 16px;
    font-weight: 700;
    color: var(--crn-or-profond);
    border: 1px solid var(--crn-or-lumiere);
    border-radius: var(--radius-pill);
    padding: 2px 12px;
  }

  .carte__nom {
    margin: 0;
    font-size: var(--text-h4-mobile);
    line-height: 1.2;
  }

  .carte__nom a {
    color: var(--crn-bleu-nuit);
    text-decoration: none;
  }

  .carte__resume {
    margin: 0;
    color: var(--crn-gris);
    font-size: 16px;
  }

  .carte__prix {
    margin: auto 0 0;
    padding-top: 6px;
    font-size: 20px;
  }

  .carte__euros {
    color: var(--crn-gris);
    font-size: 16px;
  }

  .carte__etat {
    margin: 0;
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }

  .carte__voir {
    margin-top: 8px;
    justify-content: center;
  }
</style>
