---
/*
  Textes légaux de la boutique : fournis par le CRN et saisis dans le back-office (Réglages).
  Tant qu'ils manquent, la page le dit clairement — obligatoires avant la première vente réelle.
*/
import Boutique from '../layouts/Boutique.astro';
import { reglages } from '../lib/api';

interface Props {
  titre: string;
  cle: 'cgv' | 'mentions' | 'confidentialite';
}
const { titre, cle } = Astro.props;
let texte: string | null;
let version: string | null = null;
let demo = false;
try {
  const r = await reglages();
  texte = r.legal[cle];
  version = cle === 'cgv' ? r.legal.cgvVersion : null;
  demo = r.demo;
} catch {
  texte = null;
}
---

<Boutique title={titre} demo={demo}>
  <div class="container legal">
    <h1>{titre}</h1>
    {texte ? (
      <>
        {version && <p class="legal__version">Version {version}</p>}
        <div class="legal__texte">{texte}</div>
      </>
    ) : (
      <p class="legal__attente">Texte à fournir par le Ministères Christ Révélé aux Nations (CRN) avant l’ouverture des ventes.</p>
    )}
  </div>
</Boutique>

<style>
  .legal {
    padding-top: var(--space-6);
    max-width: 820px;
  }

  .legal h1 {
    color: var(--crn-bleu-nuit);
  }

  .legal__version {
    color: var(--crn-gris);
  }

  .legal__texte {
    white-space: pre-line;
  }

  .legal__attente {
    padding: var(--space-2);
    border: 1px dashed var(--crn-or);
    border-radius: var(--radius-card-sm);
    background: var(--crn-blanc);
    font-weight: 700;
    color: var(--crn-bleu-nuit);
  }
</style>
